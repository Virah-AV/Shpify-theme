    "faq": {
      "type": "vc-contact-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Who can apply for trade pricing?",
            "answer": "<p>Interior designers, architects, stylists, contractors and businesses furnishing offices, cafés, rentals or retail spaces. Just tell us about your practice or project in the form above.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Is there a minimum order quantity for bulk pricing?",
            "answer": "<p>No strict minimum — pricing is tiered by quantity and order value. Share your requirement and we’ll send the best possible quote.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can you customise sizes, colours or finishes?",
            "answer": "<p>For larger orders we can often adjust dimensions, finishes and colours. Mention your requirements in the application and we’ll confirm what’s possible.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "I make furniture or home products — how do I sell with Virah?",
            "answer": "<p>Choose “Sell With Us” in the form and share your brand, product range and website or Instagram. If it’s a fit, we’ll walk you through onboarding, pricing and logistics.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Do you provide GST invoices?",
            "answer": "<p>Yes. Every business order comes with a proper GST invoice — just share your company name and GSTIN when we confirm your order.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "How do creator collaborations work?",
            "answer": "<p>We partner with home, décor and lifestyle creators on product features, styling stories and giveaways. Email collab@virah.co.in with your profile and media kit, or apply through the form.</p>"
          }
        }
      },
      "block_order": [
        "q1",
