    "faq": {
      "type": "vc-contact-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take across India?",
            "answer": "<p>Orders to metro cities typically arrive in <strong>3–5 business days</strong>, and <strong>5–8 business days</strong> pan-India. You’ll get a tracking link on WhatsApp and email as soon as your piece ships.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do your furniture pieces require assembly?",
            "answer": "<p>It depends on the piece. Most side tables, carts and organizers arrive <strong>pre-assembled</strong> or need under 15 minutes of set-up. Larger <strong>flat-pack</strong> items come with a complete toolkit, all hardware and an illustrated step-by-step guide — no extra tools required.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What is your return and damaged-in-transit policy?",
            "answer": "<p>We offer a <strong>7-day easy replacement</strong>. If anything arrives damaged, share your <strong>unboxing video</strong> with us — it lets us approve your claim instantly and ship a replacement at no cost.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I request custom dimensions or bulk pricing for an office or café?",
            "answer": "<p>Yes. We work with interior designers, offices, cafés and studios on custom sizes, finishes and volume orders with exclusive trade pricing.</p>",
            "link_label": "Start a trade inquiry",
            "link_url": "/pages/collaboration"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How do I care for solid wood and powder-coated metal finishes?",
            "answer": "<p><strong>Solid wood:</strong> dust with a soft dry cloth, wipe spills immediately and keep away from direct sunlight and damp walls. Use coasters for hot or wet items.</p><p><strong>Powder-coated metal:</strong> wipe with a damp cloth and mild soap, then dry. Avoid abrasive scrubbers or harsh chemicals to keep the finish looking new.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Can I see a product on video before I buy?",
            "answer": "<p>Absolutely. Message us on WhatsApp and our team will share real photos, a quick video walk-through, or measurements against your space so you can buy with confidence.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],
