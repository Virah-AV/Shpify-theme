{% comment %}
  Renders a trust highlight icon for the product page.

  Accepts:
  - icon: {String} Icon name, e.g. 'return', 'lock', 'truck'

  Usage:
  {% render 'pdp-trust-icon', icon: settings.pdp_trust_1_icon %}
{% endcomment %}

{%- case icon -%}
  {%- when 'return' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M4 12a8 8 0 1 0 2.4-5.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 3.5v4.5h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 8v4l2.6 1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="4.5" y="10.5" width="15" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 14.5v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M2.5 6.5h11v10h-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M13.5 9.5h4l3 3.5v3.5h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6.5" cy="17.5" r="1.8" fill="var(--pdp-bg, #fff)" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17.5" r="1.8" fill="var(--pdp-bg, #fff)" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'cash' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="2.5" y="6" width="19" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.6"/><path d="M6 9.5v5M18 9.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.8 12l2.2 2.2 4.2-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'quality' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><circle cx="12" cy="9.5" r="6" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 14.5L7 21l5-2.5 5 2.5-1.5-6.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.5 9.5l1.7 1.7 3.3-3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'support' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="3" y="13" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="17" y="13" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M19 19c0 1.5-1.5 2.5-4 2.5h-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'tools' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M7 3.5v12a3 3 0 0 0 3 3h10.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
