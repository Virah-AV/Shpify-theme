{%- comment -%}
  Minimal line icons for the Virah contact page sections.
  Usage: {% render 'vc-icon', icon: 'chat', size: 24 %}
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- if icon != 'none' and icon != blank -%}
<svg class="vc-icon vc-icon--{{ icon }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'chat' -%}
      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-width="2"/>
    {%- when 'whatsapp' -%}
      <path d="M3.6 20.4 5 16.3A8.6 8.6 0 1 1 8 19.2l-4.4 1.2Z"/><path d="M9.2 8.4c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.5.9 1.6 2 2.6 2.5.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.2.1.4.2.4.4 0 .5-.2 1.2-.7 1.5-.6.4-1.5.6-2.9 0a9.6 9.6 0 0 1-4.3-4.1c-.6-1.2-.5-2.2-.2-2.7Z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>
    {%- when 'phone' -%}
      <path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/>
    {%- when 'pin' -%}
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'sofa' -%}
      <path d="M5 11V8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v3"/><path d="M3 13a2 2 0 0 1 4 0v2h10v-2a2 2 0 1 1 4 0v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4Z"/><path d="M6 18v2M18 18v2"/>
    {%- when 'ruler' -%}
      <path d="m3 16.5 13.5-13.5 4.5 4.5L7.5 21 3 16.5Z"/><path d="m7 12.5 2 2M10 9.5l1.5 1.5M13 6.5l2 2"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 9.5h4l3 3.5v3.5h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'box' -%}
      <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
    {%- when 'return' -%}
      <path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'spark' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/>
    {%- when 'megaphone' -%}
      <path d="M3 10v4a1 1 0 0 0 1 1h3l8 4V5L7 9H4a1 1 0 0 0-1 1Z"/><path d="M7 15v4M19 9a3.5 3.5 0 0 1 0 6"/>
    {%- when 'briefcase' -%}
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18"/>
    {%- when 'camera' -%}
      <path d="M4 8h3l1.5-2.5h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01" stroke-width="2.2"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>
    {%- when 'shield' -%}
      <path d="M12 3 5 6v5.5c0 4.3 3 8 7 9.5 4-1.5 7-5.2 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'video' -%}
      <rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10.5 5-3v9l-5-3"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-4 6-6.5 9-8"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7M8 7h9v9"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 8v4.5M12 15.5h.01"/>
  {%- endcase -%}
</svg>
{%- endif -%}
