{% comment %}
  Renders the payment method icons shown in the footer.

  Accepts:
  - settings: {Object} The footer section settings

  Usage:
  {% render 'footer-payment-icons', settings: section.settings %}
{% endcomment %}

{%- liquid
  assign has_custom_icons = false
  if settings.payment_show_upi or settings.payment_show_cards or settings.payment_show_cod or settings.payment_show_paypal or settings.payment_show_emi
    assign has_custom_icons = true
  endif
-%}

{%- if settings.payment_enable or has_custom_icons -%}
  <div class="footer__payment">
    {%- if settings.payment_heading != blank -%}
      <h2 class="footer__payment-heading caption-large">{{ settings.payment_heading }}</h2>
    {%- else -%}
      <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
    {%- endif -%}
    <ul class="list list-payment" role="list">
      {%- if settings.payment_show_upi -%}
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-upi">
            <title id="pi-upi">UPI</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <path d="M24.5 6l3.2 6-3.2 6z" fill="#097939"/>
            <path d="M22.3 6l3.2 6-3.2 6z" fill="#ED752E"/>
            <text x="5" y="15.5" font-family="Arial, Helvetica, sans-serif" font-size="8" font-weight="700" font-style="italic" fill="#5F6368">UPI</text>
          </svg>
        </li>
      {%- endif -%}

      {%- if settings.payment_show_cards -%}
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-visa">
            <title id="pi-visa">Visa</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <text x="19" y="15.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="9" font-weight="700" font-style="italic" fill="#142688">VISA</text>
          </svg>
        </li>
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-mastercard">
            <title id="pi-mastercard">Mastercard</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <circle fill="#EB001B" cx="15" cy="12" r="7"/>
            <circle fill="#F79E1B" cx="23" cy="12" r="7"/>
            <path fill="#FF5F00" d="M19 6.3a7 7 0 010 11.4 7 7 0 010-11.4z"/>
          </svg>
        </li>
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-rupay">
            <title id="pi-rupay">RuPay</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <text x="3.5" y="15" font-family="Arial, Helvetica, sans-serif" font-size="7.5" font-weight="700" font-style="italic" fill="#1B3F8B">RuPay</text>
            <path d="M30 7.5l3.5 4.5-3.5 4.5z" fill="#F47920"/>
            <path d="M28.2 7.5l3.5 4.5-3.5 4.5z" fill="#00954C"/>
          </svg>
        </li>
      {%- endif -%}

      {%- if settings.payment_show_paypal -%}
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-paypal-custom">
            <title id="pi-paypal-custom">PayPal</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <text x="19" y="15" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8" font-weight="700" font-style="italic">
              <tspan fill="#003087">Pay</tspan><tspan fill="#009CDE">Pal</tspan>
            </text>
          </svg>
        </li>
      {%- endif -%}

      {%- if settings.payment_show_emi -%}
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-emi">
            <title id="pi-emi">EMI available</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <rect x="4" y="6" width="9" height="12" rx="1.5" fill="none" stroke="#6C3FB5" stroke-width="1.4"/>
            <path d="M6 9.5h5M6 12h5M6 14.5h3" stroke="#6C3FB5" stroke-width="1.2" stroke-linecap="round"/>
            <text x="25" y="15.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8" font-weight="700" fill="#6C3FB5">EMI</text>
          </svg>
        </li>
      {%- endif -%}

      {%- if settings.payment_show_cod -%}
        <li class="list-payment__item">
          <svg class="icon icon--full-color" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" aria-labelledby="pi-cod">
            <title id="pi-cod">Cash on Delivery</title>
            <rect width="38" height="24" rx="3" fill="#fff" stroke="#000" stroke-opacity=".07"/>
            <rect x="4" y="7" width="11" height="10" rx="1.5" fill="#2E7D32"/>
            <circle cx="9.5" cy="12" r="2.5" fill="#fff"/>
            <text x="25.5" y="15.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8" font-weight="700" fill="#2E7D32">COD</text>
          </svg>
        </li>
      {%- endif -%}

      {%- if settings.payment_enable -%}
        {%- for type in shop.enabled_payment_types -%}
          {%- comment -%} Skip icons already shown by the custom toggles above {%- endcomment -%}
          {%- liquid
            assign skip_type = false
            if settings.payment_show_cards
              if type == 'visa' or type == 'master'
                assign skip_type = true
              endif
            endif
            if settings.payment_show_paypal and type == 'paypal'
              assign skip_type = true
            endif
          -%}
          {%- if skip_type -%}
            {%- continue -%}
          {%- endif -%}
          <li class="list-payment__item">
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
