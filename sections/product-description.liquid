{% comment %}
  Editorial product description — large drop-cap narrative layout.
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

{%- if product.description != blank -%}
  <section class="pdp-description" id="PdpDescription-{{ sid }}">
    <div class="pdp-description__inner page-width">
      <span class="pdp-description__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="pdp-description__heading">{{ section.settings.heading }}</h2>
      <div class="pdp-description__body rte">
        {{ product.description }}
      </div>
    </div>
  </section>

  {%- style -%}
    #PdpDescription-{{ sid }} {
      background: #FBF9F5;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #PdpDescription-{{ sid }} .pdp-description__inner {
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
    }

    #PdpDescription-{{ sid }} .pdp-description__eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #C47355;
      margin-bottom: 14px;
    }

    #PdpDescription-{{ sid }} .pdp-description__heading {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 30px;
      font-weight: 600;
      color: #1F1D1A;
      margin: 0 0 28px;
      position: relative;
    }

    #PdpDescription-{{ sid }} .pdp-description__heading::after {
      content: '';
      display: block;
      width: 48px;
      height: 2px;
      background: #C47355;
      margin: 18px auto 0;
    }

    #PdpDescription-{{ sid }} .pdp-description__body {
      font-size: 17px;
      line-height: 1.85;
      color: #4A4640;
      text-align: left;
    }

    #PdpDescription-{{ sid }} .pdp-description__body::first-letter {
      float: left;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 64px;
      line-height: 0.8;
      font-weight: 600;
      color: #C47355;
      padding: 6px 10px 0 0;
    }

    #PdpDescription-{{ sid }} .pdp-description__body p {
      margin: 0 0 18px;
    }

    @media screen and (max-width: 599px) {
      #PdpDescription-{{ sid }} .pdp-description__heading {
        font-size: 24px;
      }

      #PdpDescription-{{ sid }} .pdp-description__body {
        font-size: 15px;
      }

      #PdpDescription-{{ sid }} .pdp-description__body::first-letter {
        font-size: 48px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Product description",
  "tag": "section",
  "class": "section pdp-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted With Intention"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 72,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 72,
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Product description"
    }
  ]
}
{% endschema %}
