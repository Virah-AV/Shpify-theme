{%- render 'vc-section-assets', font: section.settings.heading_font -%}
{%- liquid
  assign font = section.settings.heading_font
  assign s = section.settings
-%}

<section
  id="vc-projects-{{ section.id }}"
  class="vc vc-projects vc-projects--{{ s.layout }}"
  data-vc-animate="{{ s.enable_animation }}"
  style="
    --vc-bg: {{ s.background_color }};
    --vc-ink: {{ s.text_color }};
    --vc-muted: {{ s.muted_text_color }};
    --vc-accent: {{ s.accent_color }};
    --vc-heading-family: {{ font.family | escape }}, {{ font.fallback_families | escape }};
    --vc-heading-weight: {{ font.weight }};
    --vc-heading-size: {{ s.heading_size }}px;
    --vc-radius: {{ s.radius }}px;
    --vc-pt: {{ s.padding_top }}px;
    --vc-pb: {{ s.padding_bottom }}px;
    --vc-pt-m: {{ s.padding_top_mobile }}px;
    --vc-pb-m: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="vc-container">
    <div class="vc-head vc-head--split">
      <div>
        {%- if s.eyebrow != blank -%}<p class="vc-eyebrow vc-reveal">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="vc-heading vc-reveal" style="--vc-d: 1;">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<div class="vc-sub vc-reveal" style="--vc-d: 2;">{{ s.subheading }}</div>{%- endif -%}
      </div>
      {%- if s.link_label != blank -%}
        <a class="vc-link vc-reveal" style="--vc-d: 2;" href="{{ s.link_url | default: '#' }}">
          {{ s.link_label | escape }}
          {%- render 'vc-icon', icon: 'arrow', size: 16 -%}
        </a>
      {%- endif -%}
    </div>

    <ul class="vc-projects__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="vc-projects__item vc-reveal" style="--vc-d: {{ forloop.index | plus: 2 }};" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="vc-projects__card" href="{{ b.link }}">{%- else -%}<div class="vc-projects__card">{%- endif -%}
            <div class="vc-projects__media">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 1200 | image_tag: class: 'vc-projects__img', loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 40vw, 90vw', alt: b.title }}
              {%- else -%}
                {%- capture ph -%}{% cycle 'lifestyle-1', 'lifestyle-2', 'image' %}{%- endcapture -%}
                {{ ph | placeholder_svg_tag: 'vc-projects__img vc-placeholder' }}
              {%- endif -%}
              {%- if b.tag != blank -%}<span class="vc-projects__tag">{{ b.tag | escape }}</span>{%- endif -%}
            </div>
            <div class="vc-projects__body">
              {%- if b.meta != blank -%}<p class="vc-projects__meta">{{ b.meta | escape }}</p>{%- endif -%}
              {%- if b.title != blank -%}<h3 class="vc-projects__title">{{ b.title | escape }}</h3>{%- endif -%}
              {%- if b.quote != blank -%}
                <blockquote class="vc-projects__quote">
                  {{ b.quote }}
                  {%- if b.author != blank -%}<cite>— {{ b.author | escape }}</cite>{%- endif -%}
                </blockquote>
              {%- endif -%}
            </div>
          {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% style %}
  #vc-projects-{{ section.id }} .vc-projects__grid {
    display: grid;
    grid-template-columns: repeat({{ s.columns }}, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #vc-projects-{{ section.id }}.vc-projects--feature .vc-projects__grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  }

  #vc-projects-{{ section.id }}.vc-projects--feature .vc-projects__item:first-child {
    grid-row: span 2;
  }

  #vc-projects-{{ section.id }}.vc-projects--feature .vc-projects__item:first-child .vc-projects__media {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 320px;
  }

  #vc-projects-{{ section.id }} .vc-projects__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #vc-projects-{{ section.id }} .vc-projects__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ s.image_ratio }};
    border-radius: var(--vc-radius);
    background: rgba(31, 29, 26, 0.05);
  }

  #vc-projects-{{ section.id }} .vc-projects__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--vc-ease);
  }

  #vc-projects-{{ section.id }} .vc-projects__card:hover .vc-projects__img {
    transform: scale(1.05);
  }

  #vc-projects-{{ section.id }} .vc-projects__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #2b2420;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  #vc-projects-{{ section.id }} .vc-projects__body {
    padding: 18px 4px 0;
  }

  #vc-projects-{{ section.id }} .vc-projects__meta {
    margin: 0 0 6px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vc-accent);
  }

  #vc-projects-{{ section.id }} .vc-projects__title {
    margin: 0;
    font-family: var(--vc-heading-family);
    font-weight: var(--vc-heading-weight);
    font-size: 22px;
    line-height: 1.3;
    color: var(--vc-ink);
  }

  #vc-projects-{{ section.id }} .vc-projects__quote {
    margin: 12px 0 0;
    padding: 0 0 0 14px;
    border-left: 2px solid color-mix(in srgb, var(--vc-accent) 50%, transparent);
    font-size: 14.5px;
    font-style: italic;
    line-height: 1.6;
    color: var(--vc-muted);
  }

  #vc-projects-{{ section.id }} .vc-projects__quote p {
    margin: 0;
  }

  #vc-projects-{{ section.id }} .vc-projects__quote cite {
    display: block;
    margin-top: 6px;
    font-size: 12.5px;
    font-style: normal;
    font-weight: 500;
    color: var(--vc-ink);
  }

  @media screen and (max-width: 989px) {
    #vc-projects-{{ section.id }} .vc-projects__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px 8px;
      gap: 16px;
    }

    #vc-projects-{{ section.id }} .vc-projects__grid::-webkit-scrollbar {
      display: none;
    }

    #vc-projects-{{ section.id }} .vc-projects__item {
      flex: 0 0 min(340px, 80vw);
      scroll-snap-align: start;
    }

    #vc-projects-{{ section.id }}.vc-projects--feature .vc-projects__item:first-child .vc-projects__media {
      aspect-ratio: {{ s.image_ratio }};
      min-height: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Virah: Project showcase",
  "tag": "div",
  "class": "section-vc-projects",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PARTNER PROJECTS" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Spaces we’ve <em>helped shape</em>" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discuss your project" },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "grid", "label": "Even grid" },
        { "value": "feature", "label": "First project large" }
      ],
      "default": "feature"
    },
    {
      "type": "select", "id": "columns", "label": "Columns (even grid only)",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ],
      "default": "3"
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio",
      "options": [
        { "value": "4 / 3", "label": "Landscape" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" }
      ],
      "default": "4 / 3"
    },
    { "type": "range", "id": "radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "enable_animation", "label": "Reveal on scroll", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2420" },
    { "type": "color", "id": "muted_text_color", "label": "Secondary text", "default": "#6E655C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#A0704C" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Office" },
        { "type": "text", "id": "meta", "label": "Location / detail", "default": "Bengaluru · 24 pieces" },
        { "type": "text", "id": "title", "label": "Project title", "default": "Co-working studio refresh" },
        { "type": "richtext", "id": "quote", "label": "Client quote", "info": "Optional." },
        { "type": "text", "id": "author", "label": "Quote author" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional — e.g. a blog post about the project." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Virah: Project showcase",
      "blocks": [
        { "type": "project" },
        { "type": "project", "settings": { "tag": "Café", "meta": "City · pieces", "title": "Café seating & side tables" } },
        { "type": "project", "settings": { "tag": "Home", "meta": "City · pieces", "title": "Compact apartment styling" } }
      ]
    }
  ]
}
{% endschema %}
