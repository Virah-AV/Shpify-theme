{%- liquid
  assign ib_size = section.settings.image_size
  assign ib_autoplay = section.settings.enable_autoplay
  assign ib_autoplay_speed = section.settings.autoplay_speed
  assign ib_click_to_slide = section.settings.enable_click_to_slide

  # Banner height is 70% of the first image's natural height; every slide shares it.
  assign ib_ratio = blank
  for block in section.blocks
    if block.settings.image and ib_ratio == blank
      assign ib_ratio = block.settings.image.aspect_ratio | divided_by: 0.7
    endif
  endfor
-%}

<div
  class="ib-section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <ib-carousel
    id="ImageBanner-{{ section.id }}"
    class="ib-carousel ib-size--{{ ib_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    data-autoplay="{{ ib_autoplay }}"
    data-autoplay-speed="{{ ib_autoplay_speed }}"
    data-click-to-slide="{{ ib_click_to_slide }}"
    {% if ib_ratio != blank %}
      style="--ib-ratio: {{ ib_ratio }};"
    {% endif %}
  >
    <div class="ib-viewport">
      <div class="ib-track" data-ib-track role="list">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign ib_has_link = false
              if block.settings.link != blank
                assign ib_has_link = true
              endif
              assign ib_has_content = false
              if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank
                assign ib_has_content = true
              endif
              assign ib_loading = 'lazy'
              assign ib_fetch_priority = 'auto'
              if forloop.first
                assign ib_loading = 'eager'
                assign ib_fetch_priority = 'high'
              endif
            -%}
            <div
              class="ib-slide{% if forloop.first %} is-active{% endif %}"
              data-ib-slide
              role="listitem"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} of {{ forloop.length }}"
              aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}"
              {{ block.shopify_attributes }}
            >
              <div
                class="ib-slide__media{% if ib_ratio != blank %} ib-slide__media--natural{% endif %}"
                data-ib-media
              >
                {%- if block.settings.image -%}
                  {{
                    block.settings.image
                    | image_url: width: 1920
                    | image_tag:
                      class: 'ib-slide__image',
                      loading: ib_loading,
                      fetchpriority: ib_fetch_priority,
                      widths: '375, 550, 750, 1100, 1500, 1920',
                      sizes: '100vw',
                      alt: block.settings.image.alt | default: block.settings.heading
                  }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'ib-slide__image placeholder-svg' }}
                {%- endif -%}
                <span class="ib-slide__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};" aria-hidden="true"></span>
              </div>

              {%- if ib_has_content -%}
                <div class="ib-slide__content ib-slide__content--{{ block.settings.content_position }}">
                  <div class="ib-slide__box color-{{ block.settings.color_scheme }}">
                    {%- if block.settings.heading != blank -%}
                      <h2 class="ib-slide__heading inline-richtext">{{ block.settings.heading }}</h2>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="ib-slide__text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        {% if ib_has_link %}
                          href="{{ block.settings.link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                        class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %} ib-slide__button"
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if ib_has_link and block.settings.button_label == blank -%}
                <a href="{{ block.settings.link }}" class="ib-slide__link" aria-label="{{ block.settings.heading | strip_html | default: 'View' }}"></a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="ib-slide is-active" data-ib-slide role="listitem">
            <div class="ib-slide__media" data-ib-media>
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'ib-slide__image placeholder-svg' }}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- if section.settings.show_arrows -%}
        <button type="button" class="ib-arrow ib-arrow--prev" data-ib-prev aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="ImageBanner-{{ section.id }}">&larr;</button>
        <button type="button" class="ib-arrow ib-arrow--next" data-ib-next aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="ImageBanner-{{ section.id }}">&rarr;</button>
      {%- endif -%}
      {%- if section.settings.show_dots -%}
        <div class="ib-dots" data-ib-dots role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="ib-dot{% if forloop.first %} is-active{% endif %}"
              data-ib-dot
              data-index="{{ forloop.index0 }}"
              aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
              aria-controls="ImageBanner-{{ section.id }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </ib-carousel>
</div>

{% stylesheet %}
.ib-section {
  position: relative;
}

.ib-carousel {
  position: relative;
  display: block;
  max-width: 1920px;
  width: 100%;
  margin: 0 auto;
}

.ib-viewport {
  overflow: hidden;
  width: 100%;
}

.ib-track {
  display: flex;
  align-items: flex-start;
  margin: 0;
  padding: 0;
  list-style: none;
  transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  will-change: transform;
}

.ib-slide {
  position: relative;
  flex: 0 0 100%;
  min-width: 0;
}

.ib-slide__media {
  position: relative;
  width: 100%;
  height: var(--ib-height, clamp(260px, 42vh, 480px));
  overflow: hidden;
  background: rgb(var(--color-background));
}

.ib-slide__media--natural {
  height: auto;
  aspect-ratio: var(--ib-ratio);
}

.ib-slide__media--natural .ib-slide__image {
  object-fit: contain;
}

.ib-slide__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ib-slide__overlay {
  position: absolute;
  inset: 0;
  background: #000000;
  pointer-events: none;
}

.ib-slide__content {
  position: absolute;
  inset: 0;
  display: flex;
  padding: 2rem;
  pointer-events: none;
}

.ib-slide__content--top-left { align-items: flex-start; justify-content: flex-start; text-align: left; }
.ib-slide__content--top-center { align-items: flex-start; justify-content: center; text-align: center; }
.ib-slide__content--top-right { align-items: flex-start; justify-content: flex-end; text-align: right; }
.ib-slide__content--middle-left { align-items: center; justify-content: flex-start; text-align: left; }
.ib-slide__content--middle-center { align-items: center; justify-content: center; text-align: center; }
.ib-slide__content--middle-right { align-items: center; justify-content: flex-end; text-align: right; }
.ib-slide__content--bottom-left { align-items: flex-end; justify-content: flex-start; text-align: left; }
.ib-slide__content--bottom-center { align-items: flex-end; justify-content: center; text-align: center; }
.ib-slide__content--bottom-right { align-items: flex-end; justify-content: flex-end; text-align: right; }

.ib-slide__box {
  max-width: 48rem;
  padding: 2rem 2.5rem;
  border-radius: var(--text-boxes-radius, 0px);
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  pointer-events: auto;
}

.ib-slide__heading {
  margin: 0;
}

.ib-slide__text {
  margin-top: 1rem;
}

.ib-slide__button {
  margin-top: 1.5rem;
  display: inline-block;
}

.ib-slide__link {
  position: absolute;
  inset: 0;
  z-index: 2;
}

.ib-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.6);
  background: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, transform 0.2s ease;
}

.ib-arrow--prev { left: 16px; }
.ib-arrow--next { right: 16px; }

.ib-arrow:hover {
  background: rgba(0, 0, 0, 0.5);
}

.ib-arrow--prev:hover { transform: translateY(-50%) translateX(-2px); }
.ib-arrow--next:hover { transform: translateY(-50%) translateX(2px); }

.ib-dots {
  position: absolute;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  gap: 8px;
}

.ib-dot {
  width: 9px;
  height: 9px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  cursor: pointer;
}

.ib-dot.is-active {
  background: #ffffff;
}

.ib-size--small .ib-slide__media {
  --ib-height: clamp(200px, 30vh, 380px);
}

.ib-size--medium .ib-slide__media {
  --ib-height: clamp(260px, 42vh, 480px);
}

.ib-size--large .ib-slide__media {
  --ib-height: clamp(320px, 54vh, 620px);
}

@media screen and (min-width: 750px) {
  .ib-size--small .ib-slide__media { --ib-height: clamp(260px, 36vh, 440px); }
  .ib-size--medium .ib-slide__media { --ib-height: clamp(340px, 48vh, 560px); }
  .ib-size--large .ib-slide__media { --ib-height: clamp(420px, 60vh, 700px); }

  .ib-slide__content {
    padding: 4rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ib-track,
  .ib-arrow {
    transition: none;
  }
}
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ib-carousel')) {
    customElements.define(
      'ib-carousel',
      class ImageBannerCarousel extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-ib-track]');
          this.slides = Array.from(this.querySelectorAll('[data-ib-slide]'));
          this.prevBtn = this.querySelector('[data-ib-prev]');
          this.nextBtn = this.querySelector('[data-ib-next]');
          this.dots = Array.from(this.querySelectorAll('[data-ib-dot]'));
          this.current = 0;

          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.go(this.current - 1));
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.go(this.current + 1));
          this.dots.forEach((dot) => {
            dot.addEventListener('click', () => this.go(parseInt(dot.dataset.index, 10)));
          });

          if (this.dataset.clickToSlide === 'true') {
            this.slides.forEach((slide, index) => {
              const media = slide.querySelector('[data-ib-media]');
              if (media && !slide.querySelector('.ib-slide__link')) {
                media.style.cursor = 'pointer';
                media.addEventListener('click', () => this.go(index + 1));
              }
            });
          }

          let startX = 0;
          if (this.track) {
            this.track.addEventListener('touchstart', (event) => { startX = event.touches[0].clientX; }, { passive: true });
            this.track.addEventListener(
              'touchend',
              (event) => {
                const diff = event.changedTouches[0].clientX - startX;
                if (Math.abs(diff) > 40) this.go(this.current + (diff < 0 ? 1 : -1));
              },
              { passive: true }
            );
          }

          this.addEventListener('mouseenter', () => this.pauseAutoplay());
          this.addEventListener('mouseleave', () => this.initAutoplay());
          this.addEventListener('focusin', () => this.pauseAutoplay());
          this.addEventListener('focusout', () => this.initAutoplay());

          this.update();
          this.initAutoplay();
        }

        disconnectedCallback() {
          this.pauseAutoplay();
        }

        go(index) {
          const total = this.slides.length;
          if (!total) return;
          this.current = (index + total) % total;
          this.update();
        }

        update() {
          if (!this.track) return;
          this.track.style.transform = `translateX(-${this.current * 100}%)`;
          this.slides.forEach((slide, i) => {
            slide.classList.toggle('is-active', i === this.current);
            slide.setAttribute('aria-hidden', i === this.current ? 'false' : 'true');
          });
          this.dots.forEach((dot, i) => dot.classList.toggle('is-active', i === this.current));
        }

        initAutoplay() {
          this.pauseAutoplay();
          if (this.dataset.autoplay !== 'true' || this.slides.length < 2) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const speed = (parseFloat(this.dataset.autoplaySpeed) || 6) * 1000;
          this.autoplayTimer = setInterval(() => this.go(this.current + 1), speed);
        }

        pauseAutoplay() {
          clearInterval(this.autoplayTimer);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Auto slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_click_to_slide",
      "label": "Click image to advance slide",
      "info": "Only applies to slides without a link.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show navigation dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Banner size",
      "info": "When slides have images, the banner is 70% of the first image's height and every image is shown in full. This size applies only when no slide has an image.",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium (1920 x 980px)" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Clicking the image opens this link, if set."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 0
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use secondary button style",
          "default": false
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-center", "label": "Middle center" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "middle-center"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Content color scheme",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
