<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- liquid
  assign logo_image = section.settings.logo_image | default: settings.logo
  assign category_blocks = section.blocks | where: 'type', 'category_dropdown'
  assign secondary_link_blocks = section.blocks | where: 'type', 'secondary_link'
  assign highlight_query = section.settings.highlight_menu_item_title | strip | downcase
-%}

{%- style -%}
  .lux-header {
    --lux-logo-width: {{ section.settings.logo_width }}px;
    --lux-highlight-color: {{ section.settings.highlight_color }};
  }
{%- endstyle -%}

<lux-header
  class="lux-header color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} lux-header--divided{% endif %}{% if section.settings.sticky_behavior == 'sticky_blur' %} lux-header--frosted{% endif %}"
  data-sticky="{{ section.settings.sticky_behavior }}"
  data-hover-style="{{ section.settings.hover_style }}"
  data-highlight-anim="{{ section.settings.highlight_animation }}"
>
  <div class="lux-tier lux-tier--brand page-width">
    <div class="lux-brand-left">
      <button type="button" class="lux-mobile-toggle" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="LuxMobileDrawer">
        <span class="svg-wrapper lux-icon-menu">{{ 'icon-hamburger.svg' | inline_asset_content }}</span>
        <span class="svg-wrapper lux-icon-close">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </button>
      <a href="{{ routes.root_url }}" class="lux-logo">
        {%- if logo_image != blank -%}
          {%- assign logo_alt = logo_image.alt | default: shop.name | escape -%}
          {%- assign logo_height = section.settings.logo_width | divided_by: logo_image.aspect_ratio -%}
          {{ logo_image | image_url: width: 520 | image_tag:
            class: 'lux-logo__image',
            width: section.settings.logo_width,
            height: logo_height,
            alt: logo_alt,
            widths: '160, 240, 320, 520',
            loading: 'eager',
            preload: true
          }}
        {%- else -%}
          <span class="lux-logo__text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="lux-brand-center">
      {%- if settings.predictive_search_enabled -%}
        <predictive-search class="lux-search" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- else -%}
        <search-form class="lux-search">
      {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="lux-search__form">
          <div class="lux-search__field">
            <input
              class="lux-search__input"
              id="Lux-Search-Input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
              {%- endif -%}
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="reset" class="lux-search__reset hidden" aria-label="{{ 'general.search.reset' | t }}">
              <span class="svg-wrapper">{{ 'icon-close-small.svg' | inline_asset_content }}</span>
            </button>
            <button type="submit" class="lux-search__submit" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header lux-search__panel" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}
    </div>

    <div class="lux-brand-right">
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="lux-icon-btn"
          rel="nofollow"
          aria-label="{% if customer %}{{ 'customer.account_fallback' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}"
        >
          <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- endif -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="lux-icon-btn lux-icon-btn--cart">
        {%- if cart == empty -%}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {%- else -%}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>

  {%- if secondary_link_blocks.size > 0 -%}
    <nav class="lux-tier lux-tier--aux" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="lux-aux-list">
        {%- for block in secondary_link_blocks -%}
          <li class="lux-aux-item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="lux-aux-link">{{ block.settings.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <nav class="lux-tier lux-tier--primary" aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="lux-primary-list" role="list">
      {%- if category_blocks.size > 0 -%}
        {%- for block in category_blocks -%}
          {%- assign item_title = block.settings.title | default: 'Category' -%}
          {%- assign item_title_downcase = item_title | downcase -%}
          {%- assign is_highlighted = false -%}
          {%- if block.settings.highlight -%}
            {%- assign is_highlighted = true -%}
          {%- elsif highlight_query != blank and item_title_downcase == highlight_query -%}
            {%- assign is_highlighted = true -%}
          {%- endif -%}
          <li class="lux-primary-item{% if block.settings.image != blank %} lux-primary-item--has-panel{% endif %}" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="lux-primary-link{% if is_highlighted %} lux-primary-link--highlight{% endif %}">
              <span class="lux-primary-link__text">{{ item_title | escape }}</span>
              {%- if is_highlighted -%}
                <span class="lux-badge" style="--lux-badge-color: {{ block.settings.badge_color | default: section.settings.highlight_color }};">
                  <svg class="lux-badge__sparkle" viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" fill="currentColor"><path d="M12 0l2.2 7.2L21 9l-6.8 1.8L12 18l-2.2-7.2L3 9l6.8-1.8z"/></svg>
                  {{ block.settings.badge_label | default: section.settings.highlight_menu_item_title | escape }}
                </span>
              {%- endif -%}
            </a>
            {%- if block.settings.image != blank -%}
              <div class="lux-mega-panel">
                <a href="{{ block.settings.link | default: '#' }}" class="lux-mega-panel__link" tabindex="-1">
                  {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', width: 240, height: 240, class: 'lux-mega-panel__image', alt: item_title }}
                  <span class="lux-mega-panel__label">{{ item_title | escape }}</span>
                </a>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for link in section.settings.main_menu.links -%}
          {%- assign link_title_downcase = link.title | downcase -%}
          {%- assign is_highlighted = false -%}
          {%- if highlight_query != blank and link_title_downcase == highlight_query -%}
            {%- assign is_highlighted = true -%}
          {%- endif -%}
          <li class="lux-primary-item{% if link.links != blank %} lux-primary-item--has-panel{% endif %}">
            <a href="{{ link.url }}" class="lux-primary-link{% if is_highlighted %} lux-primary-link--highlight{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
              <span class="lux-primary-link__text">{{ link.title | escape }}</span>
              {%- if is_highlighted -%}
                <span class="lux-badge" style="--lux-badge-color: {{ section.settings.highlight_color }};">
                  <svg class="lux-badge__sparkle" viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" fill="currentColor"><path d="M12 0l2.2 7.2L21 9l-6.8 1.8L12 18l-2.2-7.2L3 9l6.8-1.8z"/></svg>
                  {{ section.settings.highlight_menu_item_title | escape }}
                </span>
              {%- endif -%}
            </a>
            {%- if link.links != blank -%}
              <div class="lux-dropdown-panel">
                <ul class="lux-dropdown-list">
                  {%- for childlink in link.links -%}
                    <li><a href="{{ childlink.url }}" class="lux-dropdown-link">{{ childlink.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
</lux-header>

<div id="LuxMobileDrawer" class="lux-drawer" hidden>
  <div class="lux-drawer__overlay" data-lux-drawer-close></div>
  <div class="lux-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="lux-drawer__header">
      <a href="{{ routes.root_url }}" class="lux-logo lux-logo--drawer">
        {%- if logo_image != blank -%}
          {{ logo_image | image_url: width: 240 | image_tag: width: 120, height: 120, alt: shop.name }}
        {%- else -%}
          <span class="lux-logo__text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <button type="button" class="lux-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-lux-drawer-close>
        <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </button>
    </div>
    <nav class="lux-drawer__nav">
      <ul class="lux-drawer__list lux-drawer__list--primary">
        {%- if category_blocks.size > 0 -%}
          {%- for block in category_blocks -%}
            <li><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title | default: 'Category' | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for link in section.settings.main_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if secondary_link_blocks.size > 0 -%}
        <ul class="lux-drawer__list lux-drawer__list--aux">
          {%- for block in secondary_link_blocks -%}
            <li><a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>
    <div class="lux-drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="lux-drawer__account">
          {%- if customer -%}{{ 'customer.account_fallback' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'drawer' -%}
{%- endif -%}
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
.lux-header {
  position: relative;
  z-index: 3;
  display: block;
  background: rgb(var(--color-background));
}

.lux-header--divided {
  border-bottom: 1px solid #E5E5E5;
}

.lux-header--frosted {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.lux-tier {
  display: flex;
  align-items: center;
  width: 100%;
}

.lux-tier--brand {
  justify-content: space-between;
  gap: 24px;
  padding: 16px 3rem;
}

.lux-brand-left,
.lux-brand-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
  min-width: 140px;
}

.lux-brand-right {
  justify-content: flex-end;
}

.lux-brand-center {
  flex: 1 1 auto;
  display: flex;
  justify-content: center;
  max-width: 640px;
  margin: 0 auto;
}

.lux-mobile-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: none;
  background: transparent;
  cursor: pointer;
  padding: 0;
  color: inherit;
}

.lux-mobile-toggle .lux-icon-close {
  display: none;
}

.lux-mobile-toggle[aria-expanded="true"] .lux-icon-menu {
  display: none;
}

.lux-mobile-toggle[aria-expanded="true"] .lux-icon-close {
  display: flex;
}

.lux-logo {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  color: inherit;
}

.lux-logo__image {
  width: var(--lux-logo-width, 150px);
  height: auto;
  display: block;
}

.lux-logo__text {
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 500;
  font-size: 15px;
  white-space: nowrap;
}

.lux-search {
  position: relative;
  display: block;
  width: 100%;
}

.lux-search__field {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 44px;
  border-radius: 999px;
  background: #F4F4F4;
  padding: 0 6px 0 20px;
}

.lux-search__input {
  flex: 1 1 auto;
  height: 100%;
  border: none;
  background: transparent;
  outline: none;
  font-size: 14px;
  color: #1a1a1a;
  min-width: 0;
}

.lux-search__input::placeholder {
  color: #9b9b9b;
}

.lux-search__reset {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border: none;
  background: transparent;
  color: #8a8a8a;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.lux-search__reset.hidden {
  display: none;
}

.lux-search__submit {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: #ECECEC;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #1a1a1a;
  transition: background 0.2s ease;
}

.lux-search__submit:hover {
  background: #E2E2E2;
}

.lux-search__submit .svg-wrapper,
.lux-search__reset .svg-wrapper {
  width: 16px;
  height: 16px;
  display: flex;
}

.lux-search__panel {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  z-index: 20;
}

.lux-icon-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #F0F0F0;
  color: #1a1a1a;
  text-decoration: none;
  transition: background 0.2s ease;
}

.lux-icon-btn:hover {
  background: #E6E6E6;
}

.lux-icon-btn .svg-wrapper {
  width: 18px;
  height: 18px;
  display: flex;
}

.lux-icon-btn .cart-count-bubble {
  position: absolute;
  top: -6px;
  right: -6px;
  bottom: auto;
  left: auto;
  border-radius: 50%;
  font-size: 11px;
  height: 1.8rem;
  width: 1.8rem;
}

.lux-tier--aux {
  justify-content: center;
  border-top: 1px solid #E5E5E5;
  padding: 8px 0;
}

.lux-aux-list {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  margin: 0;
  padding: 0;
}

.lux-aux-item {
  border-right: 1px solid #E5E5E5;
}

.lux-aux-item:last-child {
  border-right: none;
}

.lux-aux-link {
  display: inline-block;
  padding: 0 18px;
  font-size: 13px;
  font-weight: 400;
  color: #4A4A4A;
  text-decoration: none;
  transition: color 0.2s ease;
}

.lux-aux-link:hover,
.lux-aux-link[aria-current="page"] {
  color: #000000;
}

.lux-tier--primary {
  justify-content: center;
  border-top: 1px solid #E5E5E5;
  padding: 12px 0;
}

.lux-primary-list {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 4px;
  margin: 0;
  padding: 0;
}

.lux-primary-item {
  position: relative;
}

.lux-primary-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  font-size: 12.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #1a1a1a;
  text-decoration: none;
}

.lux-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 2px 8px;
  border-radius: 999px;
  background: #FBEDE7;
  color: var(--lux-badge-color, var(--lux-highlight-color, #E07A5F));
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

.lux-mega-panel,
.lux-dropdown-panel {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  padding: 16px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 15;
}

.lux-primary-item--has-panel:hover .lux-mega-panel,
.lux-primary-item--has-panel:hover .lux-dropdown-panel,
.lux-primary-item--has-panel:focus-within .lux-mega-panel,
.lux-primary-item--has-panel:focus-within .lux-dropdown-panel {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(4px);
}

.lux-mega-panel__link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 160px;
  color: #1a1a1a;
  text-decoration: none;
}

.lux-mega-panel__image {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 8px;
}

.lux-mega-panel__label {
  font-size: 12px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.lux-dropdown-list {
  list-style: none;
  margin: 0;
  padding: 0;
  min-width: 180px;
}

.lux-dropdown-link {
  display: block;
  padding: 8px 12px;
  font-size: 13px;
  color: #1a1a1a;
  text-decoration: none;
  white-space: nowrap;
  border-radius: 6px;
}

.lux-dropdown-link:hover {
  background: #F6F6F6;
}

[data-hover-style="expand_line"] .lux-primary-link::after,
[data-hover-style="expand_line"] .lux-aux-link::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 2px;
  width: calc(100% - 32px);
  height: 1.5px;
  background: #000000;
  transform: translateX(-50%) scaleX(0);
  transition: transform 0.25s ease;
}

[data-hover-style="expand_line"] .lux-primary-link:hover::after,
[data-hover-style="expand_line"] .lux-aux-link:hover::after {
  transform: translateX(-50%) scaleX(1);
}

[data-hover-style="color_fade"] .lux-primary-link,
[data-hover-style="color_fade"] .lux-aux-link {
  transition: color 0.2s ease, transform 0.2s ease;
}

[data-hover-style="color_fade"] .lux-primary-link:hover,
[data-hover-style="color_fade"] .lux-aux-link:hover {
  color: #6b6b6b;
  transform: translateY(-2px);
}

[data-hover-style="pill_highlight"] .lux-primary-link,
[data-hover-style="pill_highlight"] .lux-aux-link {
  border-radius: 999px;
  transition: background 0.2s ease;
}

[data-hover-style="pill_highlight"] .lux-primary-link:hover,
[data-hover-style="pill_highlight"] .lux-aux-link:hover {
  background: #F4EBE1;
}

[data-highlight-anim="pulse"] .lux-badge {
  animation: lux-badge-pulse 2.2s ease-in-out infinite;
}

@keyframes lux-badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

[data-highlight-anim="shimmer"] .lux-badge {
  position: relative;
  overflow: hidden;
}

[data-highlight-anim="shimmer"] .lux-badge::before {
  content: "";
  position: absolute;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  animation: lux-badge-shimmer 2.4s ease-in-out infinite;
}

@keyframes lux-badge-shimmer {
  0% { left: -60%; }
  100% { left: 120%; }
}

.lux-drawer {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.lux-drawer[hidden] {
  display: none;
}

.lux-drawer__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.lux-drawer__panel {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: min(320px, 86vw);
  background: #ffffff;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  overflow-y: auto;
}

.lux-drawer.is-open .lux-drawer__panel {
  transform: translateX(0);
}

.lux-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #E5E5E5;
}

.lux-drawer__close {
  width: 32px;
  height: 32px;
  border: none;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lux-drawer__nav {
  flex: 1 1 auto;
  padding: 12px 8px;
}

.lux-drawer__list {
  list-style: none;
  margin: 0 0 8px;
  padding: 0;
}

.lux-drawer__list a {
  display: block;
  padding: 12px 16px;
  font-size: 14px;
  color: #1a1a1a;
  text-decoration: none;
  border-radius: 8px;
}

.lux-drawer__list--primary a {
  font-size: 12.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.lux-drawer__list--aux a {
  font-size: 13px;
  color: #4A4A4A;
}

.lux-drawer__list a:hover {
  background: #F6F6F6;
}

.lux-drawer__footer {
  padding: 16px 20px;
  border-top: 1px solid #E5E5E5;
}

.lux-drawer__account {
  font-size: 13px;
  color: #1a1a1a;
  text-decoration: none;
}

@media screen and (max-width: 989px) {
  .lux-tier--aux,
  .lux-tier--primary {
    display: none;
  }

  .lux-mobile-toggle {
    display: flex;
  }

  .lux-tier--brand {
    flex-wrap: wrap;
    padding: 12px 20px;
  }

  .lux-brand-center {
    order: 3;
    flex: 1 1 100%;
    max-width: none;
    margin-top: 10px;
  }

  .lux-brand-left,
  .lux-brand-right {
    min-width: auto;
  }
}

@media screen and (min-width: 990px) {
  .lux-mobile-toggle {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lux-badge,
  .lux-badge::before,
  .lux-primary-link::after,
  .lux-aux-link::after,
  .lux-drawer__panel {
    animation: none !important;
    transition: none !important;
  }
}
{% endstylesheet %}

{% javascript %}
  class LuxHeader extends HTMLElement {
    connectedCallback() {
      this.sectionHeader = this.closest('.section-header') || this.parentElement;
      this.stickyMode = this.dataset.sticky;
      this.toggleBtn = this.querySelector('.lux-mobile-toggle');
      this.drawer = document.getElementById('LuxMobileDrawer');

      this.setHeaderHeight = this.setHeaderHeight.bind(this);
      this.onScroll = this.onScroll.bind(this);

      this.setHeaderHeight();
      window.addEventListener('resize', this.setHeaderHeight);

      if (this.stickyMode === 'sticky_blur') {
        this.sectionHeader.classList.add('shopify-section-header-sticky');
      } else if (this.stickyMode === 'hide_reveal') {
        this.lastScroll = 0;
        window.addEventListener('scroll', this.onScroll, { passive: true });
      }

      if (this.toggleBtn && this.drawer) {
        this.toggleBtn.addEventListener('click', () => this.openDrawer());

        this.drawer.querySelectorAll('[data-lux-drawer-close]').forEach((element) => {
          element.addEventListener('click', () => this.closeDrawer());
        });

        this.drawer.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') this.closeDrawer();
        });

        this.drawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => this.closeDrawer());
        });
      }
    }

    setHeaderHeight() {
      if (!this.sectionHeader) return;
      document.documentElement.style.setProperty('--header-height', `${this.sectionHeader.offsetHeight}px`);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop > this.lastScroll && scrollTop > this.offsetHeight) {
        this.sectionHeader.classList.add('shopify-section-header-sticky', 'shopify-section-header-hidden', 'animate');
      } else if (scrollTop < this.lastScroll) {
        this.sectionHeader.classList.add('shopify-section-header-sticky', 'animate');
        this.sectionHeader.classList.remove('shopify-section-header-hidden');
      }

      if (scrollTop <= 0) {
        this.sectionHeader.classList.remove('shopify-section-header-sticky', 'shopify-section-header-hidden', 'animate');
      }

      this.lastScroll = scrollTop;
    }

    openDrawer() {
      this.drawer.hidden = false;
      requestAnimationFrame(() => this.drawer.classList.add('is-open'));
      this.toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    closeDrawer() {
      this.drawer.classList.remove('is-open');
      this.toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        this.drawer.hidden = true;
      }, 300);
    }
  }

  customElements.define('lux-header', LuxHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

