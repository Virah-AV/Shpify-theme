{%- render 'vc-section-assets', font: section.settings.heading_font -%}
{%- liquid
  assign font = section.settings.heading_font
  assign s = section.settings
  assign profile = s.profile_url
  if profile == blank
    assign profile = settings.social_instagram_link
  endif
-%}

<section
  id="vc-insta-{{ section.id }}"
  class="vc vc-insta"
  data-vc-animate="{{ s.enable_animation }}"
  style="
    --vc-bg: {{ s.background_color }};
    --vc-ink: {{ s.text_color }};
    --vc-muted: {{ s.muted_text_color }};
    --vc-accent: {{ s.accent_color }};
    --vc-heading-family: {{ font.family | escape }}, {{ font.fallback_families | escape }};
    --vc-heading-weight: {{ font.weight }};
    --vc-heading-size: {{ s.heading_size }}px;
    --vc-cols: {{ s.columns }};
    --vc-gap: {{ s.gap }}px;
    --vc-radius: {{ s.radius }}px;
    --vc-pt: {{ s.padding_top }}px;
    --vc-pb: {{ s.padding_bottom }}px;
    --vc-pt-m: {{ s.padding_top_mobile }}px;
    --vc-pb-m: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="{% if s.full_width %}vc-insta__full{% else %}vc-container{% endif %}">
    <div class="vc-head vc-head--center{% if s.full_width %} vc-container{% endif %}">
      {%- if s.show_badge and s.handle != blank -%}
        <a class="vc-insta__badge vc-reveal" href="{{ profile | default: '#' }}" target="_blank" rel="noopener">
          {%- render 'vc-icon', icon: 'instagram', size: 16 -%}
          <span>{{ s.handle | escape }}</span>
        </a>
      {%- endif -%}
      {%- if s.heading != blank -%}<h2 class="vc-heading vc-reveal" style="--vc-d: 1;">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.subheading != blank -%}<div class="vc-sub vc-reveal" style="--vc-d: 2;">{{ s.subheading }}</div>{%- endif -%}
    </div>

    <ul class="vc-insta__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign link = b.link | default: profile
          assign delay = forloop.index0 | plus: 2
          assign alt = b.caption | default: s.handle
        -%}
        <li class="vc-insta__item vc-reveal" style="--vc-d: {{ delay }};" {{ block.shopify_attributes }}>
          <a class="vc-insta__frame" href="{{ link | default: '#' }}" target="_blank" rel="noopener" aria-label="{{ alt | escape }}">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 800 | image_tag: class: 'vc-insta__img', loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 990px) 20vw, 60vw', alt: alt }}
            {%- else -%}
              {%- capture ph -%}{% cycle 'lifestyle-1', 'lifestyle-2', 'image', 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'vc-insta__img vc-placeholder' }}
            {%- endif -%}
            <span class="vc-insta__overlay" aria-hidden="true">
              {%- render 'vc-icon', icon: 'instagram', size: 26 -%}
              {%- if b.caption != blank and s.show_captions -%}<span class="vc-insta__caption">{{ b.caption | escape }}</span>{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.cta_label != blank -%}
      <div class="vc-insta__cta vc-reveal" style="--vc-d: 6;">
        <a class="vc-btn" href="{{ profile | default: '#' }}" target="_blank" rel="noopener">
          {%- render 'vc-icon', icon: 'instagram', size: 18 -%}
          {{ s.cta_label | escape }}
          {%- render 'vc-icon', icon: 'arrow', size: 18 -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #vc-insta-{{ section.id }} .vc-insta__full {
    width: 100%;
  }

  #vc-insta-{{ section.id }} .vc-head {
    margin-bottom: 40px;
  }

  #vc-insta-{{ section.id }} .vc-insta__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--vc-ink);
    color: var(--vc-bg);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform 0.35s var(--vc-ease);
  }

  #vc-insta-{{ section.id }} .vc-insta__badge:hover {
    transform: translateY(-2px);
  }

  #vc-insta-{{ section.id }} .vc-insta__grid {
    display: grid;
    grid-template-columns: repeat(var(--vc-cols), minmax(0, 1fr));
    gap: var(--vc-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #vc-insta-{{ section.id }} .vc-insta__frame {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--vc-radius);
    background: rgba(31, 29, 26, 0.05);
    isolation: isolate;
  }

  #vc-insta-{{ section.id }} .vc-insta__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--vc-ease);
  }

  {%- if s.hover_zoom -%}
    #vc-insta-{{ section.id }} .vc-insta__frame:hover .vc-insta__img {
      transform: scale(1.07);
    }
  {%- endif -%}

  #vc-insta-{{ section.id }} .vc-insta__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    background: rgba(31, 29, 26, 0.42);
    color: #fff;
    text-align: center;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  #vc-insta-{{ section.id }} .vc-insta__overlay .vc-icon {
    transform: translateY(8px) scale(0.9);
    transition: transform 0.5s var(--vc-ease);
  }

  #vc-insta-{{ section.id }} .vc-insta__frame:hover .vc-insta__overlay,
  #vc-insta-{{ section.id }} .vc-insta__frame:focus-visible .vc-insta__overlay {
    opacity: 1;
  }

  #vc-insta-{{ section.id }} .vc-insta__frame:hover .vc-insta__overlay .vc-icon {
    transform: none;
  }

  #vc-insta-{{ section.id }} .vc-insta__caption {
    font-size: 13px;
    line-height: 1.4;
  }

  #vc-insta-{{ section.id }} .vc-insta__cta {
    margin-top: 40px;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    #vc-insta-{{ section.id }} .vc-insta__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 0 20px;
      {%- unless s.full_width -%}margin: 0 -20px;{%- endunless -%}
    }

    #vc-insta-{{ section.id }} .vc-insta__grid::-webkit-scrollbar {
      display: none;
    }

    #vc-insta-{{ section.id }} .vc-insta__item {
      flex: 0 0 min(260px, 62vw);
      scroll-snap-align: start;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Virah: Instagram strip",
  "tag": "div",
  "class": "section-vc-contact-instagram",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Heading & handle" },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "@virah" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link", "info": "Leave empty to use the Instagram link from Theme settings › Social media." },
    { "type": "checkbox", "id": "show_badge", "label": "Show handle badge", "default": true },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tag <em>@virah</em> to be featured in our lookbook" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Real homes, real corners — styled by our community across India.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Follow on Instagram" },
    { "type": "header", "content": "Grid" },
    {
      "type": "select", "id": "columns", "label": "Photos per row (desktop)",
      "options": [ { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" } ],
      "default": "5"
    },
    { "type": "range", "id": "gap", "label": "Gap between photos", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "radius", "label": "Photo corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom photos on hover", "default": true },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions on hover", "default": true },
    { "type": "checkbox", "id": "full_width", "label": "Full-width grid", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 36 },
    { "type": "checkbox", "id": "enable_animation", "label": "Reveal on scroll", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F4EE" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2420" },
    { "type": "color", "id": "muted_text_color", "label": "Secondary text", "default": "#6E655C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#A0704C" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square lifestyle photos work best (1080 × 1080)." },
        { "type": "text", "id": "caption", "label": "Caption / alt text", "info": "e.g. “Aisha’s reading nook, Pune”" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional — link to the Instagram post. Defaults to your profile." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Virah: Instagram strip",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
