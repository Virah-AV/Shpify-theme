{%- liquid
  assign ec_blocks = section.blocks
-%}

<div
  class="ec-section"
  style="--ec-bg: {{ section.settings.background_color }}; --ec-accent: {{ section.settings.accent_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ec-container page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ec-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ec-grid" role="list">
      {%- for block in ec_blocks -%}
        <li class="ec-item" {{ block.shopify_attributes }}>
          <span class="ec-item__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="ec-item__title">{{ block.settings.title | escape }}</h3>
          <div class="ec-item__text">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="ec-item__link">
              <span>{{ block.settings.link_label | escape }}</span>
              <span class="ec-item__arrow svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
.ec-section {
  background: var(--ec-bg, #FFFFFF);
}

.ec-heading {
  margin: 0 0 32px;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(24px, 3vw, 32px);
  font-weight: 500;
  color: #1A1A18;
}

.ec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
  border-top: 1px solid #E5E1D8;
}

.ec-item {
  position: relative;
  padding: 32px 28px 32px 0;
  border-bottom: 1px solid #E5E1D8;
  border-right: 1px solid #E5E1D8;
  transition: background 0.3s ease;
}

.ec-item:first-child {
  padding-left: 0;
}

.ec-item:last-child {
  border-right: none;
}

.ec-item::before {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 0%;
  height: 2px;
  background: var(--ec-accent, #C9A227);
  transition: width 0.4s ease;
}

.ec-item:hover::before {
  width: 100%;
}

.ec-item:hover {
  background: rgba(0, 0, 0, 0.015);
}

.ec-item__index {
  display: block;
  margin-bottom: 18px;
  font-family: 'SFMono-Regular', Consolas, 'Courier New', monospace;
  font-size: 13px;
  letter-spacing: 0.1em;
  color: var(--ec-accent, #C9A227);
}

.ec-item__title {
  margin: 0 0 12px;
  font-size: 19px;
  font-weight: 600;
  color: #1A1A18;
}

.ec-item__text {
  margin: 0 0 20px;
  font-size: 14px;
  line-height: 1.6;
  color: #5A574F;
}

.ec-item__text p {
  margin: 0;
}

.ec-item__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #1A1A18;
  text-decoration: none;
}

.ec-item__arrow {
  width: 14px;
  height: 14px;
  display: flex;
  transition: transform 0.3s ease;
}

.ec-item:hover .ec-item__arrow {
  transform: translateX(4px);
}

@media screen and (max-width: 989px) {
  .ec-grid {
    grid-template-columns: 1fr;
    border-top: none;
  }

  .ec-item {
    padding: 24px 0;
    border-right: none;
  }

  .ec-item:first-child {
    border-top: 1px solid #E5E1D8;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ec-item,
  .ec-item::before,
  .ec-item__arrow {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Services We Provide"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (index, underline, arrow)",
      "default": "#C9A227"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Column title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Editorial columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
