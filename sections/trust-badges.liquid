<div
  class="tb-section"
  style="--tb-bg: {{ section.settings.background_color }}; --tb-accent: {{ section.settings.accent_color }}; --tb-icon: {{ section.settings.icon_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="tb-container page-width">
    <ul class="tb-grid" role="list">
      {%- for block in section.blocks -%}
        <li class="tb-item" {{ block.shopify_attributes }}>
          <span class="tb-item__icon-wrap">
            <svg class="tb-item__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              {{ block.settings.svg_icon }}
            </svg>
          </span>
          <span class="tb-item__title">{{ block.settings.title | escape }}</span>
          <span class="tb-item__text">{{ block.settings.paragraph }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
.tb-section {
  background: var(--tb-bg, #F4F4F4);
}

.tb-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
}

.tb-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  padding: 28px 20px;
}

.tb-item + .tb-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1px;
  background: rgba(0, 0, 0, 0.08);
}

.tb-item__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 1.5px solid var(--tb-accent, #C9A227);
  color: var(--tb-icon, #1A1A18);
  transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
}

.tb-item__icon {
  width: 22px;
  height: 22px;
}

.tb-item:hover .tb-item__icon-wrap {
  background: var(--tb-accent, #C9A227);
  color: #FFFFFF;
  transform: translateY(-4px) scale(1.05);
}

.tb-item__title {
  font-size: 15px;
  font-weight: 600;
  color: #1A1A18;
}

.tb-item__text {
  font-size: 13px;
  line-height: 1.5;
  color: #6B6B66;
  max-width: 220px;
}

@media screen and (max-width: 749px) {
  .tb-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .tb-item:nth-child(2n)::before {
    display: none;
  }

  .tb-item:nth-child(n + 3)::after {
    content: "";
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
  }
}

@media (prefers-reduced-motion: reduce) {
  .tb-item__icon-wrap {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#2B2420"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (icon ring + hover fill)",
      "default": "#9A6B43"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_icon",
          "label": "SVG path",
          "info": "Paste the inner <path> markup of an icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "textarea",
          "id": "paragraph",
          "label": "Text",
          "default": "Enjoy free delivery on all orders"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}
