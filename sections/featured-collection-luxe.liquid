{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign lx_collection = section.settings.collection
  assign lx_limit = section.settings.products_to_show
  assign lx_columns = section.settings.columns_desktop
  assign lx_enable_buy_now = section.settings.enable_buy_now
  assign lx_products = lx_collection.products
-%}

<div
  class="lx-section"
  style="--lx-bg: {{ section.settings.background_color }}; --lx-accent: {{ section.settings.accent_color }}; --lx-columns: {{ lx_columns }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lx-container page-width">
    <lx-carousel class="lx-carousel">
      <div class="lx-header">
        {%- if section.settings.heading != blank -%}
          <h2 class="lx-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="lx-header__right">
          {%- if lx_products.size > 0 -%}
            <span class="lx-meta">{{ lx_products.size }} pieces</span>
          {%- endif -%}
          <div class="lx-nav">
            <button type="button" class="lx-arrow lx-arrow--prev" data-lx-prev aria-label="{{ 'general.slider.previous_slide' | t }}">&larr;</button>
            <button type="button" class="lx-arrow lx-arrow--next" data-lx-next aria-label="{{ 'general.slider.next_slide' | t }}">&rarr;</button>
          </div>
        </div>
      </div>

      <ul class="lx-grid" data-lx-track role="list">
      {%- if lx_products != blank -%}
        {%- for product in lx_products limit: lx_limit -%}
          {%- liquid
            assign lx_variant = product.selected_or_first_available_variant
            assign lx_form_id = 'LX-Form-' | append: section.id | append: '-' | append: product.id
          -%}
          <li class="lx-grid__item">
            <div class="lx-card">
              <div class="lx-card__media">
                <a href="{{ product.url }}" class="lx-card__media-link" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 700
                      | image_tag:
                        class: 'lx-card__image',
                        loading: 'lazy',
                        widths: '350, 500, 700',
                        sizes: '(min-width: 990px) 20vw, (min-width: 750px) 45vw, 85vw',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {%- else -%}
                    {{ 'product-apparel-2' | placeholder_svg_tag: 'lx-card__image lx-card__image--placeholder' }}
                  {%- endif -%}
                </a>
                <span class="lx-corner lx-corner--tl" aria-hidden="true"></span>
                <span class="lx-corner lx-corner--br" aria-hidden="true"></span>

                {%- if product.available -%}
                  <form
                    id="{{ lx_form_id }}"
                    method="post"
                    action="{{ routes.cart_add_url }}"
                    accept-charset="UTF-8"
                    class="lx-hidden-form"
                  >
                    <input type="hidden" name="id" value="{{ lx_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                  </form>

                  <lx-quick-add class="lx-actions">
                    <button type="submit" form="{{ lx_form_id }}" name="add" class="lx-action" aria-label="{{ 'products.product.add_to_cart' | t }} - {{ product.title | escape }}">
                      <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
                      <span class="svg-wrapper lx-action__spinner hidden">{%- render 'loading-spinner' -%}</span>
                    </button>
                    {%- if lx_enable_buy_now -%}
                      <button type="submit" form="{{ lx_form_id }}" name="buy" class="lx-action lx-action--buy" aria-label="Buy now - {{ product.title | escape }}">
                        <span class="svg-wrapper">{{ 'icon-lightning-bolt.svg' | inline_asset_content }}</span>
                        <span class="svg-wrapper lx-action__spinner hidden">{%- render 'loading-spinner' -%}</span>
                      </button>
                    {%- endif -%}
                  </lx-quick-add>
                {%- endif -%}
              </div>

              <div class="lx-card__info">
                <a href="{{ product.url }}" class="lx-card__title-link">
                  <h3 class="lx-card__title">{{ product.title | escape }}</h3>
                </a>
                <div class="lx-card__price">
                  {%- render 'price', product: product, price_class: '', show_badges: false, show_compare_at_price: true -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..lx_limit) -%}
          <li class="lx-grid__item">
            <div class="lx-card">
              <div class="lx-card__media">
                {{ 'product-apparel-2' | placeholder_svg_tag: 'lx-card__image lx-card__image--placeholder' }}
              </div>
              <div class="lx-card__info">
                <h3 class="lx-card__title">{{ 'onboarding.product_title' | t }}</h3>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    </lx-carousel>
  </div>
</div>

{% stylesheet %}
.lx-section {
  background: var(--lx-bg, #1B1812);
}

.lx-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 28px;
}

.lx-header__right {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
}

.lx-heading {
  margin: 0;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(24px, 3vw, 32px);
  font-weight: 500;
  color: #F5F1E8;
}

.lx-meta {
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--lx-accent, #C9A227);
  white-space: nowrap;
}

.lx-nav {
  display: flex;
  gap: 10px;
  flex-shrink: 0;
}

.lx-arrow {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid rgba(245, 241, 232, 0.25);
  background: transparent;
  color: #F5F1E8;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.lx-arrow:not(:disabled):hover {
  background: var(--lx-accent, #C9A227);
  border-color: var(--lx-accent, #C9A227);
  color: #1B1812;
}

.lx-arrow--prev:not(:disabled):hover {
  transform: translateX(-3px);
}

.lx-arrow--next:not(:disabled):hover {
  transform: translateX(3px);
}

.lx-arrow:disabled {
  opacity: 0.3;
  cursor: default;
  pointer-events: none;
}

.lx-grid {
  display: flex;
  gap: 20px;
  list-style: none;
  margin: 0;
  padding: 4px 4px 8px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.lx-grid::-webkit-scrollbar {
  display: none;
}

.lx-grid__item {
  flex: 0 0 calc((100% - (var(--lx-columns, 5) - 1) * 20px) / var(--lx-columns, 5));
  scroll-snap-align: start;
  min-width: 0;
}

.lx-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.lx-card__media {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border: 1px solid rgba(201, 162, 39, 0.25);
}

.lx-card__media-link {
  display: block;
  width: 100%;
  height: 100%;
}

.lx-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(0.35) brightness(0.94);
  transform: scale(1.001);
  transition: transform 0.5s ease, filter 0.5s ease;
}

.lx-card:hover .lx-card__image {
  transform: scale(1.06);
  filter: grayscale(0) brightness(1);
}

.lx-corner {
  position: absolute;
  width: 18px;
  height: 18px;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.lx-corner--tl {
  top: 8px;
  left: 8px;
  border-top: 1.5px solid var(--lx-accent, #C9A227);
  border-left: 1.5px solid var(--lx-accent, #C9A227);
}

.lx-corner--br {
  bottom: 8px;
  right: 8px;
  border-bottom: 1.5px solid var(--lx-accent, #C9A227);
  border-right: 1.5px solid var(--lx-accent, #C9A227);
}

.lx-card:hover .lx-corner {
  opacity: 1;
}

.lx-hidden-form {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.lx-actions {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  z-index: 3;
  display: flex;
  gap: 8px;
  justify-content: center;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.lx-card:hover .lx-actions,
.lx-card:focus-within .lx-actions {
  opacity: 1;
  transform: translateY(0);
}

.lx-action {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(245, 241, 232, 0.92);
  color: #1B1812;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.lx-action--buy {
  background: var(--lx-accent, #C9A227);
  color: #1B1812;
}

.lx-action:hover {
  background: #FFFFFF;
}

.lx-action--buy:hover {
  background: var(--lx-accent, #C9A227);
  filter: brightness(1.1);
}

.lx-action .svg-wrapper {
  width: 16px;
  height: 16px;
  display: flex;
}

.lx-action__spinner.hidden {
  display: none;
}

.lx-card__info {
  padding: 14px 2px 0;
}

.lx-card__title-link {
  text-decoration: none;
}

.lx-card__title {
  margin: 0 0 6px;
  font-size: 13.5px;
  font-weight: 500;
  color: #F5F1E8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lx-card__price .price {
  font-size: 13px;
  color: var(--lx-accent, #C9A227);
}

.lx-card__price .price__sale .price-item--regular {
  color: rgba(245, 241, 232, 0.45);
}

@media screen and (max-width: 989px) and (min-width: 750px) {
  .lx-grid__item {
    flex: 0 0 calc((100% - 2 * 20px) / 3);
  }
}

@media screen and (max-width: 749px) {
  .lx-header {
    flex-wrap: wrap;
  }

  .lx-header__right {
    gap: 10px;
  }

  .lx-grid {
    gap: 14px;
  }

  .lx-grid__item {
    flex: 0 0 calc((100% - 14px) / 2);
  }

  .lx-actions {
    opacity: 1;
    transform: none;
    position: static;
    margin-top: 8px;
  }

  .lx-corner {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lx-card__image,
  .lx-actions,
  .lx-corner,
  .lx-action {
    transition: none;
  }
}
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('lx-carousel')) {
    customElements.define(
      'lx-carousel',
      class LxCarousel extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-lx-track]');
          this.prevBtn = this.querySelector('[data-lx-prev]');
          this.nextBtn = this.querySelector('[data-lx-next]');
          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.scrollByDirection(-1));
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.scrollByDirection(1));

          this.updateArrowState = this.updateArrowState.bind(this);
          if (this.track) this.track.addEventListener('scroll', this.updateArrowState, { passive: true });
          window.addEventListener('resize', this.updateArrowState);
          requestAnimationFrame(this.updateArrowState);
        }

        updateArrowState() {
          if (!this.track) return;
          const maxScroll = this.track.scrollWidth - this.track.clientWidth;
          const current = this.track.scrollLeft;
          if (this.prevBtn) this.prevBtn.disabled = current <= 1;
          if (this.nextBtn) this.nextBtn.disabled = maxScroll <= 1 || current >= maxScroll - 1;
        }

        scrollByDirection(direction) {
          if (!this.track) return;
          const slide = this.track.querySelector('.lx-grid__item');
          if (!slide) return;
          const styles = getComputedStyle(this.track);
          const gap = parseFloat(styles.columnGap || styles.gap || '0');
          const amount = slide.getBoundingClientRect().width + gap;
          this.track.scrollBy({ left: amount * direction, behavior: 'smooth' });
        }
      }
    );
  }

  if (!customElements.get('lx-quick-add')) {
    customElements.define(
      'lx-quick-add',
      class LxQuickAdd extends HTMLElement {
        constructor() {
          super();
          this.card = this.closest('.lx-card');
          this.form = this.card.querySelector('form.lx-hidden-form');
          this.cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
          if (this.form) this.form.addEventListener('submit', this.onSubmit.bind(this));
        }

        onSubmit(event) {
          event.preventDefault();
          const button = event.submitter;
          if (!button || button.getAttribute('aria-disabled') === 'true') return;
          const isBuyNow = button.name === 'buy';

          const triggers = this.card.querySelectorAll(`button[form="${this.form.id}"]`);
          triggers.forEach((trigger) => trigger.setAttribute('aria-disabled', 'true'));
          const spinner = button.querySelector('.lx-action__spinner');
          if (spinner) spinner.classList.remove('hidden');

          const formData = new FormData(this.form);
          if (!isBuyNow && this.cart) {
            formData.append(
              'sections',
              this.cart.getSectionsToRender().map((section) => section.id)
            );
            formData.append('sections_url', window.location.pathname);
            this.cart.setActiveElement(document.activeElement);
          }

          const config = fetchConfig('javascript');
          config.headers['X-Requested-With'] = 'XMLHttpRequest';
          delete config.headers['Content-Type'];
          config.body = formData;

          fetch(`${routes.cart_add_url}`, config)
            .then((response) => response.json())
            .then((response) => {
              if (response.status) {
                publish(PUB_SUB_EVENTS.cartError, {
                  source: 'lx-quick-add',
                  productVariantId: formData.get('id'),
                  errors: response.errors || response.description,
                  message: response.message,
                });
                return;
              }

              if (isBuyNow) {
                window.location.href = `${window.Shopify.routes.root}checkout`;
                return;
              }

              publish(PUB_SUB_EVENTS.cartUpdate, {
                source: 'lx-quick-add',
                productVariantId: formData.get('id'),
                cartData: response,
              });

              if (!this.cart) {
                window.location = window.routes.cart_url;
                return;
              }

              this.cart.renderContents(response);
            })
            .catch((error) => {
              console.error(error);
            })
            .finally(() => {
              if (isBuyNow) return;
              triggers.forEach((trigger) => trigger.removeAttribute('aria-disabled'));
              if (spinner) spinner.classList.add('hidden');
              if (this.cart && this.cart.classList.contains('is-empty')) this.cart.classList.remove('is-empty');
            });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Luxe collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "label": "Product limit"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" },
        { "value": "5", "label": "5 columns" }
      ],
      "default": "5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coffee Tables"
    },
    {
      "type": "checkbox",
      "id": "enable_buy_now",
      "label": "Enable Buy Now",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1B1812"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (price, corners, Buy Now)",
      "default": "#C9A227"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Luxe collection"
    }
  ]
}
{% endschema %}
