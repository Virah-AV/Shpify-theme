{% comment %}
  Warm Japandi / Editorial Minimalist product showcase.
  Split layout: media gallery (left) + buy box (right), equal height on desktop.
  Clicking the main image opens a full-screen viewer with zoom.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign product_form_id = 'PdpForm-' | append: sid

  if product
    assign current_variant = product.selected_or_first_available_variant
    assign price = current_variant.price
    assign compare_at_price = current_variant.compare_at_price
    assign is_on_sale = false
    if compare_at_price > price
      assign is_on_sale = true
      assign save_amount = compare_at_price | minus: price
      assign save_percent = save_amount | times: 100.0 | divided_by: compare_at_price | round: 0
    endif

    assign lb_images = product.media | where: 'media_type', 'image'

    assign crumb_collection = collection
    if crumb_collection == blank
      assign crumb_collection = product.collections.first
    endif
  endif
-%}

<section class="pdp-showcase" id="PdpShowcase-{{ sid }}" data-pdp-showcase>
  {%- if product -%}
    <div class="pdp-showcase__inner page-width">
      <div class="pdp-gallery" data-pdp-gallery>
        <div class="pdp-gallery__thumbs" data-pdp-thumbs>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-pdp-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80 }}
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="pdp-gallery__stage">
          <button type="button" class="pdp-gallery__wishlist" data-pdp-wishlist aria-label="Save to wishlist" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path d="M12 20.5s-7.5-4.6-10-9.3C.4 7.8 2 4.5 5.3 3.8c2-.4 4 .5 5 2.2 1-1.7 3-2.6 5-2.2C18.6 4.5 20.2 7.8 18.6 11.2c-2.5 4.7-10 9.3-10 9.3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </button>

          {%- if lb_images.size > 0 -%}
            <div class="pdp-gallery__tools">
              <button type="button" class="pdp-gallery__tool" data-pdp-zoom-out aria-label="Zoom out" disabled>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="M15.5 15.5L20 20M7.8 10.5h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
              <button type="button" class="pdp-gallery__tool" data-pdp-zoom-in aria-label="Zoom in">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="M15.5 15.5L20 20M7.8 10.5h5.4M10.5 7.8v5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
              <button type="button" class="pdp-gallery__tool" data-pdp-expand aria-label="View images full screen">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {%- endif -%}

          {%- if product.media.size > 0 -%}
            {%- assign lb_count = 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign loading_value = 'lazy'
                if forloop.first
                  assign loading_value = 'eager'
                endif
              -%}
              <div
                class="pdp-gallery__frame{% if forloop.first %} is-active{% endif %}"
                data-pdp-slide
                data-index="{{ forloop.index0 }}"
                {% if media.media_type == 'image' %}
                  data-lb-index="{{ lb_count }}"
                {% endif %}
              >
                {%- if media.media_type == 'image' -%}
                  {%- assign lb_count = lb_count | plus: 1 -%}
                {%- endif -%}
                {{
                  media
                  | media_tag:
                    image_size: '1600x',
                    loading: loading_value,
                    class: 'pdp-gallery__media',
                    controls: true,
                    loop: false
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="pdp-gallery__frame is-active pdp-gallery__frame--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'pdp-gallery__placeholder' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="pdp-buybox-col">
        <div class="pdp-buy-box pdp-buy-box" id="ProductBuyBox-{{ sid }}" data-pdp-buy-box>
          {%- if section.settings.show_breadcrumb -%}
            <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
              <a href="{{ routes.root_url }}">Home</a>
              {%- if crumb_collection != blank -%}
                <span class="pdp-breadcrumb__sep" aria-hidden="true">/</span>
                <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

          <h1 class="pdp-title">{{ product.title }}</h1>

          <div class="pdp-price" data-pdp-price>
            <span class="pdp-price__current" data-pdp-price-current>{{ price | money }}</span>
            <s class="pdp-price__compare" data-pdp-price-compare {% unless is_on_sale %}hidden{% endunless %}>
              {% if is_on_sale %}{{ compare_at_price | money }}{% endif %}
            </s>
            <span class="pdp-price__badge" data-pdp-save-badge {% unless is_on_sale %}hidden{% endunless %}>
              Save {{ save_percent }}%
            </span>
          </div>

          {%- if section.settings.show_rating and product.metafields.reviews.rating.value != blank -%}
            {%- liquid
              assign rating = product.metafields.reviews.rating.value
              assign rating_count = product.metafields.reviews.rating_count.value | default: 0
              assign rating_percent = rating.rating | times: 100.0 | divided_by: rating.scale_max
            -%}
            <a href="#judgeme_product_reviews" class="pdp-rating" aria-label="Rated {{ rating.rating | round: 1 }} out of {{ rating.scale_max }}, {{ rating_count }} reviews">
              <span class="pdp-rating__stars" style="--pdp-rating: {{ rating_percent }}%;" aria-hidden="true"></span>
              <span class="pdp-rating__value" aria-hidden="true">{{ rating.rating | round: 1 }}</span>
              {%- if rating_count > 0 -%}
                <span class="pdp-rating__count" aria-hidden="true">({{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %})</span>
              {%- endif -%}
            </a>
          {%- endif -%}

          <div class="pdp-stock" data-pdp-stock>
            <span class="pdp-stock__dot{% unless current_variant.available %} pdp-stock__dot--off{% endunless %}" data-pdp-stock-dot></span>
            <span data-pdp-stock-text>
              {%- if current_variant.available -%}
                In Stock
              {%- else -%}
                Currently Unavailable — Join the Waitlist
              {%- endif -%}
            </span>
            {%- liquid
              assign low_stock_text = ''
              if section.settings.show_low_stock and current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
                if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold
                  assign low_stock_text = 'Only ' | append: current_variant.inventory_quantity | append: ' left'
                endif
              endif
            -%}
            <span class="pdp-stock__low" data-pdp-low-stock {% if low_stock_text == blank %}hidden{% endif %}>
              {{- low_stock_text -}}
            </span>
          </div>

          {%- if section.settings.show_low_stock -%}
            <script type="application/json" data-pdp-inventory>
              {
                {%- for variant in product.variants -%}
                  {%- liquid
                    assign tracked_qty = -1
                    if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
                      assign tracked_qty = variant.inventory_quantity
                    endif
                  -%}
                  "{{ variant.id }}": {{ tracked_qty }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            </script>
          {%- endif -%}

          {%- if section.settings.delivery_estimate != blank -%}
            <div class="pdp-delivery">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
                <path d="M2.5 6.5h11v9h-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M13.5 9.5h4l3 3v3h-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <circle cx="6.5" cy="17" r="1.8" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="17" cy="17" r="1.8" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <span>{{ section.settings.delivery_label }} <strong>{{ section.settings.delivery_estimate }}</strong></span>
            </div>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            <div class="pdp-options" data-pdp-options>
              {%- for option in product.options_with_values -%}
                <div class="pdp-option" data-option-index="{{ forloop.index0 }}">
                  <p class="pdp-option__label">
                    {{ option.name }}: <span data-pdp-option-value>{{ option.selected_value }}</span>
                  </p>
                  <div class="pdp-pills">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="pdp-pill{% if value == option.selected_value %} is-active{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-value="{{ value | escape }}"
                      >
                        {{- value -}}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <script type="application/json" data-pdp-variants>
            {{ product.variants | json }}
          </script>

          <div
            class="pdp-form-wrapper"
            data-pdp-currency="{{ cart.currency.iso_code }}"
            data-pdp-locale="{{ request.locale.iso_code }}"
          >
            <div class="pdp-form-error" data-pdp-error hidden></div>
            {%- form 'product', product, id: product_form_id, class: 'pdp-form', novalidate: 'novalidate' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                data-pdp-variant-id
                {% unless current_variant.available %}disabled{% endunless %}
              >
              {%- if section.settings.show_quantity -%}
                <div class="pdp-quantity">
                  <label class="pdp-option__label" for="Quantity-{{ sid }}">Quantity</label>
                  <div class="pdp-quantity__control">
                    <button type="button" class="pdp-quantity__btn" data-pdp-qty-minus aria-label="Decrease quantity">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </button>
                    <input
                      type="number"
                      id="Quantity-{{ sid }}"
                      class="pdp-quantity__input"
                      name="quantity"
                      value="1"
                      min="1"
                      step="1"
                      inputmode="numeric"
                      data-pdp-qty-input
                    >
                    <button type="button" class="pdp-quantity__btn" data-pdp-qty-plus aria-label="Increase quantity">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </button>
                  </div>
                </div>
              {%- else -%}
                <input type="hidden" name="quantity" value="1" data-pdp-qty-input>
              {%- endif -%}
              <div class="pdp-actions">
                <button
                  type="submit"
                  name="add"
                  class="pdp-btn pdp-btn--outline"
                  data-pdp-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-pdp-add-label>
                    {%- if current_variant.available -%}
                      Add to Cart
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </span>
                  <span class="pdp-btn__spinner" data-pdp-spinner hidden></span>
                </button>
                <button
                  type="button"
                  class="pdp-btn pdp-btn--solid"
                  data-pdp-instant-buy
                  data-variant-id="{{ current_variant.id }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  Instant Buy Now
                </button>
              </div>
            {%- endform -%}
          </div>

          {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank -%}
            <ul class="pdp-trust" role="list">
              {%- if section.settings.trust_1 != blank -%}
                <li class="pdp-trust__item">
                  <span class="pdp-trust__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="2.5" y="6" width="19" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.6"/><path d="M6 9.5v5M18 9.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </span>
                  <span class="pdp-trust__text">{{ section.settings.trust_1 }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.trust_2 != blank -%}
                <li class="pdp-trust__item">
                  <span class="pdp-trust__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="4.5" y="10.5" width="15" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 14.5v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </span>
                  <span class="pdp-trust__text">{{ section.settings.trust_2 }}</span>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_share -%}
            {%- liquid
              assign share_url = request.origin | append: product.url
              assign share_text = product.title | append: ' - ' | append: shop.name
              assign share_whatsapp = share_text | append: ' ' | append: share_url
              assign share_image = product.featured_image | image_url: width: 1200 | prepend: 'https:'
            -%}
            <div class="pdp-share">
              <span class="pdp-share__label">Share</span>
              <div class="pdp-share__links">
                <a
                  class="pdp-share__link"
                  href="https://wa.me/?text={{ share_whatsapp | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Share on WhatsApp"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"/></svg>
                </a>
                <a
                  class="pdp-share__link"
                  href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Share on Facebook"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4a20 20 0 0 0-2.2-.1c-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21z"/></svg>
                </a>
                <a
                  class="pdp-share__link"
                  href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ share_image | url_encode }}&description={{ share_text | url_encode }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Pin on Pinterest"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3l.1.4-.3 1.1c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2z"/></svg>
                </a>
                <button type="button" class="pdp-share__link" data-pdp-instagram data-url="{{ share_url }}" aria-label="Share on Instagram">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
                </button>
                <button type="button" class="pdp-share__link" data-pdp-copy-link data-url="{{ share_url }}" aria-label="Copy link">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
                <span class="pdp-share__copied" data-pdp-copied role="status" aria-live="polite"></span>
              </div>
            </div>
          {%- endif -%}

          {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
          {%- if app_blocks.size > 0 -%}
            <div class="pdp-app-blocks">
              {%- for block in app_blocks -%}
                {% render block %}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if lb_images.size > 0 -%}
      <div
        class="pdp-lightbox{% if lb_images.size == 1 %} pdp-lightbox--single{% endif %}"
        id="PdpLightbox-{{ sid }}"
        data-pdp-lightbox
        role="dialog"
        aria-modal="true"
        aria-label="{{ product.title | escape }} images"
        hidden
      >
        <div class="pdp-lightbox__bar">
          <span class="pdp-lightbox__counter" data-lb-counter aria-live="polite"></span>
          <div class="pdp-lightbox__zoom">
            <button type="button" class="pdp-lightbox__btn" data-lb-zoom-out aria-label="Zoom out">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button type="button" class="pdp-lightbox__level" data-lb-zoom-reset aria-label="Reset zoom">100%</button>
            <button type="button" class="pdp-lightbox__btn" data-lb-zoom-in aria-label="Zoom in">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
          </div>
          <button type="button" class="pdp-lightbox__btn pdp-lightbox__close" data-lb-close aria-label="Close">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div class="pdp-lightbox__main">
          <button type="button" class="pdp-lightbox__btn pdp-lightbox__nav pdp-lightbox__nav--prev" data-lb-prev aria-label="Previous image">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="pdp-lightbox__viewport" data-lb-viewport>
            <img class="pdp-lightbox__image" data-lb-image alt="" draggable="false">
          </div>
          <button type="button" class="pdp-lightbox__btn pdp-lightbox__nav pdp-lightbox__nav--next" data-lb-next aria-label="Next image">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="pdp-lightbox__thumbs">
          {%- for image in lb_images -%}
            <button
              type="button"
              class="pdp-lightbox__thumb"
              data-lb-thumb
              data-index="{{ forloop.index0 }}"
              data-src="{{ image | image_url: width: 2400 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="Show image {{ forloop.index }}"
            >
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="pdp-showcase__placeholder page-width">
      <p>Add a product to preview the showcase.</p>
    </div>
  {%- endif -%}
</section>

{%- style -%}
  #PdpShowcase-{{ sid }} {
    --pdp-bg: {{ section.settings.background_color }};
    --pdp-surface: {{ section.settings.surface_color }};
    --pdp-image-bg: {{ section.settings.image_background }};
    --pdp-text: {{ section.settings.text_color }};
    --pdp-muted: {{ section.settings.muted_color }};
    --pdp-accent: {{ section.settings.accent_color }};
    --pdp-onyx: {{ section.settings.button_color }};
    --pdp-onyx-text: {{ section.settings.button_text_color }};
    --pdp-star: {{ section.settings.star_color }};
    background: var(--pdp-bg);
    color: var(--pdp-text);
    padding-top: {{ section.settings.padding_top }}px;
