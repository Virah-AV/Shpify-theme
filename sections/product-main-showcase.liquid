    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--pdp-text) 14%, transparent);
    background: transparent;
    color: var(--pdp-text);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #PdpShowcase-{{ sid }} .pdp-share__link:hover {
    background: var(--pdp-accent);
    border-color: var(--pdp-accent);
    color: #ffffff;
  }

  #PdpShowcase-{{ sid }} .pdp-share__copied {
    font-size: 12px;
    color: var(--pdp-accent);
  }

  #PdpShowcase-{{ sid }} .pdp-app-blocks {
    margin-top: 20px;
  }

  @media screen and (max-width: 989px) {
    #PdpShowcase-{{ sid }} .pdp-showcase__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    #PdpShowcase-{{ sid }} .pdp-buy-box {
      padding: 28px;
    }
  }

  @media screen and (max-width: 599px) {
    #PdpShowcase-{{ sid }} .pdp-gallery {
      grid-template-columns: 1fr;
    }

    #PdpShowcase-{{ sid }} .pdp-gallery__thumbs {
      flex-direction: row;
      order: 2;
      max-height: none;
      overflow-x: auto;
      overflow-y: visible;
    }

    #PdpShowcase-{{ sid }} .pdp-gallery__stage {
      order: 1;
    }

    #PdpShowcase-{{ sid }} .pdp-actions {
      grid-template-columns: 1fr;
    }

    #PdpShowcase-{{ sid }} .pdp-title {
      font-size: 26px;
    }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('PdpShowcase-{{ sid }}');
    if (!root || root.dataset.pdpInitialized) return;
    root.dataset.pdpInitialized = 'true';

    var buyBox = root.querySelector('[data-pdp-buy-box]');
    var variantScript = root.querySelector('[data-pdp-variants]');
    var variants = [];
    try {
      variants = variantScript ? JSON.parse(variantScript.textContent) : [];
    } catch (e) {
      variants = [];
    }

    var inventoryScript = root.querySelector('[data-pdp-inventory]');
    var inventory = {};
    try {
      inventory = inventoryScript ? JSON.parse(inventoryScript.textContent) : {};
    } catch (e) {
      inventory = {};
    }
    var lowStockThreshold = {{ section.settings.low_stock_threshold }};

    var thumbs = root.querySelectorAll('[data-pdp-thumb]');
    var slides = root.querySelectorAll('[data-pdp-slide]');

    function showFrame(index) {
      index = String(index);
      thumbs.forEach(function (t) {
        t.classList.toggle('is-active', t.dataset.index === index);
      });
      slides.forEach(function (slide) {
        slide.classList.toggle('is-active', slide.dataset.index === index);
      });
      setStageZoom(1);
    }

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        showFrame(thumb.dataset.index);
      });
    });

    /* ---- Inline zoom on the main image ---- */
    var stage = root.querySelector('.pdp-gallery__stage');
    var stageZoomIn = root.querySelector('[data-pdp-zoom-in]');
    var stageZoomOut = root.querySelector('[data-pdp-zoom-out]');
    var stageExpand = root.querySelector('[data-pdp-expand]');
    var stageZoom = 1;
    var STAGE_MAX_ZOOM = 3;

    function activeFrame() {
      return root.querySelector('[data-pdp-slide].is-active');
    }

    function activeStageImage() {
      var frame = activeFrame();
      return frame && frame.hasAttribute('data-lb-index') ? frame.querySelector('img') : null;
    }

    function setStageZoom(level) {
      var img = activeStageImage();
      stageZoom = Math.min(STAGE_MAX_ZOOM, Math.max(1, level));
      slides.forEach(function (slide) {
        var slideImg = slide.querySelector('img');
        if (slideImg && slideImg !== img) {
          slideImg.style.transform = '';
          slideImg.style.transformOrigin = '';
        }
      });
      if (img) {
        img.style.transform = stageZoom > 1 ? 'scale(' + stageZoom + ')' : '';
        if (stageZoom === 1) img.style.transformOrigin = '';
      } else {
        stageZoom = 1;
      }
      if (stage) stage.classList.toggle('is-zoomed', stageZoom > 1);
      if (stageZoomOut) stageZoomOut.disabled = stageZoom <= 1;
      if (stageZoomIn) stageZoomIn.disabled = !img || stageZoom >= STAGE_MAX_ZOOM;
    }

    if (stage) {
      if (stageZoomIn) {
        stageZoomIn.addEventListener('click', function () {
          setStageZoom(stageZoom + 0.5);
        });
      }
      if (stageZoomOut) {
        stageZoomOut.addEventListener('click', function () {
          setStageZoom(stageZoom - 0.5);
        });
      }
      stage.addEventListener('pointermove', function (evt) {
        if (stageZoom <= 1) return;
        var img = activeStageImage();
        if (!img) return;
        var rect = stage.getBoundingClientRect();
        var x = ((evt.clientX - rect.left) / rect.width) * 100;
        var y = ((evt.clientY - rect.top) / rect.height) * 100;
        img.style.transformOrigin = x + '% ' + y + '%';
      });
      stage.addEventListener('click', function (evt) {
        if (evt.target.closest('button, a, video, model-viewer')) return;
        var frame = activeFrame();
        if (frame && frame.hasAttribute('data-lb-index')) {
          openLightbox(parseInt(frame.dataset.lbIndex, 10));
        }
      });
      if (stageExpand) {
        stageExpand.addEventListener('click', function () {
          var frame = activeFrame();
          var lbIndex = frame && frame.hasAttribute('data-lb-index') ? parseInt(frame.dataset.lbIndex, 10) : 0;
          openLightbox(lbIndex);
        });
      }
      setStageZoom(1);
    }

    /* ---- Full-screen viewer ---- */
    var lightbox = root.querySelector('[data-pdp-lightbox]');
    var lbThumbs = lightbox ? Array.prototype.slice.call(lightbox.querySelectorAll('[data-lb-thumb]')) : [];
    var lbViewport = lightbox && lightbox.querySelector('[data-lb-viewport]');
    var lbImage = lightbox && lightbox.querySelector('[data-lb-image]');
    var lbCounter = lightbox && lightbox.querySelector('[data-lb-counter]');
    var lbLevel = lightbox && lightbox.querySelector('[data-lb-zoom-reset]');
    var lbZoomIn = lightbox && lightbox.querySelector('[data-lb-zoom-in]');
    var lbZoomOut = lightbox && lightbox.querySelector('[data-lb-zoom-out]');
    var lbClose = lightbox && lightbox.querySelector('[data-lb-close]');
    var lbPrev = lightbox && lightbox.querySelector('[data-lb-prev]');
    var lbNext = lightbox && lightbox.querySelector('[data-lb-next]');
    var LB_MAX_ZOOM = 5;
    var lbIndex = 0;
    var lbScale = 1;
    var lbX = 0;
    var lbY = 0;
    var lbLastFocus = null;
    var lbPointers = {};
    var lbDrag = null;
    var lbPinch = null;

    function lbApply() {
      if (!lbImage) return;
      lbImage.style.transform = 'translate(' + lbX + 'px, ' + lbY + 'px) scale(' + lbScale + ')';
      lbViewport.classList.toggle('is-zoomed', lbScale > 1);
      if (lbLevel) lbLevel.textContent = Math.round(lbScale * 100) + '%';
      if (lbZoomOut) lbZoomOut.disabled = lbScale <= 1;
      if (lbZoomIn) lbZoomIn.disabled = lbScale >= LB_MAX_ZOOM;
    }

    function lbClamp() {
      var maxX = Math.max(0, (lbImage.offsetWidth * lbScale - lbViewport.clientWidth) / 2);
      var maxY = Math.max(0, (lbImage.offsetHeight * lbScale - lbViewport.clientHeight) / 2);
      lbX = Math.min(maxX, Math.max(-maxX, lbX));
      lbY = Math.min(maxY, Math.max(-maxY, lbY));
    }

    // Zoom keeping the point (px, py), relative to the viewport centre, under the cursor.
    function lbZoomTo(scale, px, py) {
      var next = Math.min(LB_MAX_ZOOM, Math.max(1, scale));
      px = px || 0;
      py = py || 0;
      var ratio = next / lbScale;
      lbX = px - (px - lbX) * ratio;
      lbY = py - (py - lbY) * ratio;
      lbScale = next;
      if (lbScale === 1) {
        lbX = 0;
        lbY = 0;
      }
      lbClamp();
      lbApply();
    }

    function lbPointFromEvent(evt) {
      var rect = lbViewport.getBoundingClientRect();
      return {
        x: evt.clientX - rect.left - rect.width / 2,
        y: evt.clientY - rect.top - rect.height / 2,
      };
    }

    function lbShow(index) {
      if (!lbThumbs.length) return;
      lbIndex = (index + lbThumbs.length) % lbThumbs.length;
      var thumb = lbThumbs[lbIndex];
      lbScale = 1;
      lbX = 0;
      lbY = 0;
      // Show the already-loaded thumbnail at once, then swap in the full-size image.
      var shownIndex = lbIndex;
      var preview = root.querySelector('[data-pdp-slide][data-lb-index="' + lbIndex + '"] img');
      if (!preview || !preview.complete || !preview.naturalWidth) preview = thumb.querySelector('img');
      if (preview && preview.complete && preview.naturalWidth) lbImage.src = preview.currentSrc || preview.src;
      var full = new Image();
      full.onload = function () {
        if (lbIndex === shownIndex) lbImage.src = full.src;
      };
      full.src = thumb.dataset.src;
      lbImage.alt = thumb.dataset.alt || '';
      lbApply();
      if (lbCounter) lbCounter.textContent = lbIndex + 1 + ' / ' + lbThumbs.length;
      lbThumbs.forEach(function (t, i) {
        t.classList.toggle('is-active', i === lbIndex);
        if (i === lbIndex) t.setAttribute('aria-current', 'true');
        else t.removeAttribute('aria-current');
      });
      thumb.scrollIntoView({ block: 'nearest', inline: 'center' });
      [lbIndex + 1, lbIndex - 1].forEach(function (i) {
        var neighbour = lbThumbs[(i + lbThumbs.length) % lbThumbs.length];
        if (neighbour) new Image().src = neighbour.dataset.src;
      });
    }

    function onLightboxKey(evt) {
      if (evt.key === 'Escape') {
        evt.preventDefault();
        closeLightbox();
      } else if (evt.key === 'ArrowRight') {
        lbShow(lbIndex + 1);
      } else if (evt.key === 'ArrowLeft') {
        lbShow(lbIndex - 1);
      } else if (evt.key === '+' || evt.key === '=') {
        lbZoomTo(lbScale + 0.5);
      } else if (evt.key === '-') {
        lbZoomTo(lbScale - 0.5);
      } else if (evt.key === 'Tab') {
        var focusables = Array.prototype.filter.call(lightbox.querySelectorAll('button'), function (el) {
          return !el.disabled && el.offsetParent !== null;
        });
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (evt.shiftKey && document.activeElement === first) {
          evt.preventDefault();
          last.focus();
        } else if (!evt.shiftKey && document.activeElement === last) {
          evt.preventDefault();
          first.focus();
        }
      }
    }

    function openLightbox(index) {
      if (!lightbox) return;
      // Move to <body> so no transformed ancestor can clip the fixed overlay.
      if (lightbox.parentNode !== document.body) document.body.appendChild(lightbox);
      lbLastFocus = document.activeElement;
      lightbox.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      lbShow(index || 0);
      document.addEventListener('keydown', onLightboxKey);
      if (lbClose) lbClose.focus();
    }

    function closeLightbox() {
      if (!lightbox || lightbox.hidden) return;
      lightbox.hidden = true;
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onLightboxKey);
      var frame = root.querySelector('[data-pdp-slide][data-lb-index="' + lbIndex + '"]');
      if (frame) showFrame(frame.dataset.index);
      if (lbLastFocus && lbLastFocus.focus) lbLastFocus.focus();
    }

    if (lightbox) {
      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', function () {
        lbShow(lbIndex - 1);
      });
      lbNext.addEventListener('click', function () {
        lbShow(lbIndex + 1);
      });
      lbZoomIn.addEventListener('click', function () {
        lbZoomTo(lbScale + 0.5);
      });
      lbZoomOut.addEventListener('click', function () {
        lbZoomTo(lbScale - 0.5);
      });
      lbLevel.addEventListener('click', function () {
        lbZoomTo(1);
      });
      lbThumbs.forEach(function (thumb, i) {
        thumb.addEventListener('click', function () {
          lbShow(i);
        });
      });

      lbViewport.addEventListener(
        'wheel',
        function (evt) {
          evt.preventDefault();
          var point = lbPointFromEvent(evt);
          lbZoomTo(lbScale * (evt.deltaY < 0 ? 1.2 : 1 / 1.2), point.x, point.y);
        },
        { passive: false }
      );

      lbViewport.addEventListener('dblclick', function (evt) {
        var point = lbPointFromEvent(evt);
        lbZoomTo(lbScale > 1 ? 1 : 2.5, point.x, point.y);
      });

      lbViewport.addEventListener('pointerdown', function (evt) {
        lbViewport.setPointerCapture(evt.pointerId);
        lbPointers[evt.pointerId] = { x: evt.clientX, y: evt.clientY };
        var ids = Object.keys(lbPointers);
        if (ids.length === 2) {
          var a = lbPointers[ids[0]];
          var b = lbPointers[ids[1]];
          lbPinch = { distance: Math.hypot(a.x - b.x, a.y - b.y), scale: lbScale };
          lbDrag = null;
        } else if (ids.length === 1) {
          lbDrag = { startX: evt.clientX, startY: evt.clientY, x: lbX, y: lbY, moved: false };
        }
      });

      lbViewport.addEventListener('pointermove', function (evt) {
        if (!lbPointers[evt.pointerId]) return;
        lbPointers[evt.pointerId] = { x: evt.clientX, y: evt.clientY };
        var ids = Object.keys(lbPointers);
        if (lbPinch && ids.length === 2) {
          var a = lbPointers[ids[0]];
          var b = lbPointers[ids[1]];
          var distance = Math.hypot(a.x - b.x, a.y - b.y);
          lbScale = Math.min(LB_MAX_ZOOM, Math.max(1, lbPinch.scale * (distance / lbPinch.distance)));
          if (lbScale === 1) {
            lbX = 0;
            lbY = 0;
          }
          lbClamp();
          lbApply();
          return;
        }
        if (!lbDrag) return;
        var dx = evt.clientX - lbDrag.startX;
        var dy = evt.clientY - lbDrag.startY;
        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) lbDrag.moved = true;
        if (lbScale > 1) {
          lbViewport.classList.add('is-dragging');
          lbX = lbDrag.x + dx;
          lbY = lbDrag.y + dy;
          lbClamp();
          lbApply();
        }
      });

      function endPointer(evt) {
        if (!lbPointers[evt.pointerId]) return;
        delete lbPointers[evt.pointerId];
        lbViewport.classList.remove('is-dragging');
        if (lbPinch) {
          if (Object.keys(lbPointers).length < 2) lbPinch = null;
          lbDrag = null;
          return;
        }
        if (lbDrag && lbScale === 1 && evt.type === 'pointerup') {
          var dx = evt.clientX - lbDrag.startX;
          if (Math.abs(dx) > 50) lbShow(lbIndex + (dx < 0 ? 1 : -1));
        }
        lbDrag = null;
      }

      lbViewport.addEventListener('pointerup', endPointer);
      lbViewport.addEventListener('pointercancel', endPointer);

      // Clicking the dark backdrop around the image closes the viewer.
      lightbox.addEventListener('click', function (evt) {
        if (evt.target === lightbox || evt.target.classList.contains('pdp-lightbox__main')) closeLightbox();
      });

      window.addEventListener('resize', function () {
        if (lightbox.hidden) return;
        lbClamp();
        lbApply();
      });
    }

    var wishlistButton = root.querySelector('[data-pdp-wishlist]');
    if (wishlistButton) {
      var wishlistKey = 'pdp-wishlist-{{ product.id }}';
      if (window.localStorage && window.localStorage.getItem(wishlistKey)) {
        wishlistButton.setAttribute('aria-pressed', 'true');
      }
      wishlistButton.addEventListener('click', function () {
        var pressed = wishlistButton.getAttribute('aria-pressed') === 'true';
        wishlistButton.setAttribute('aria-pressed', String(!pressed));
        try {
          if (window.localStorage) {
            if (pressed) {
              window.localStorage.removeItem(wishlistKey);
            } else {
              window.localStorage.setItem(wishlistKey, '1');
            }
          }
        } catch (e) {
          /* localStorage unavailable */
        }
      });
    }

    var optionsWrapper = root.querySelector('[data-pdp-options]');
    var selected = [];
    if (optionsWrapper) {
      var groups = optionsWrapper.querySelectorAll('.pdp-option');
      groups.forEach(function (group) {
        var active = group.querySelector('.pdp-pill.is-active');
        selected[parseInt(group.dataset.optionIndex, 10)] = active ? active.dataset.value : null;
      });
    }

    var formWrapper = root.querySelector('.pdp-form-wrapper');
    var currencyCode = (formWrapper && formWrapper.dataset.pdpCurrency) || 'USD';
    var localeCode = (formWrapper && formWrapper.dataset.pdpLocale) || 'en';

    function formatMoney(cents) {
      try {
        return new Intl.NumberFormat(localeCode, { style: 'currency', currency: currencyCode }).format(cents / 100);
      } catch (e) {
        return '$' + (cents / 100).toFixed(2);
      }
    }

    function findMatchingVariant() {
      if (!selected.length) return variants[0];
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var matches = true;
        for (var j = 0; j < selected.length; j++) {
          if (selected[j] && v.options[j] !== selected[j]) {
            matches = false;
            break;
          }
        }
        if (matches) return v;
      }
      return null;
    }

    function updateUI(variant) {
      var priceEl = buyBox.querySelector('[data-pdp-price-current]');
      var compareEl = buyBox.querySelector('[data-pdp-price-compare]');
      var badgeEl = buyBox.querySelector('[data-pdp-save-badge]');
      var stockDot = buyBox.querySelector('[data-pdp-stock-dot]');
      var stockText = buyBox.querySelector('[data-pdp-stock-text]');
      var variantIdInput = buyBox.querySelector('[data-pdp-variant-id]');
      var addButton = buyBox.querySelector('[data-pdp-add-to-cart]');
      var addLabel = buyBox.querySelector('[data-pdp-add-label]');
      var instantButton = buyBox.querySelector('[data-pdp-instant-buy]');

      if (!variant) {
        if (addButton) addButton.setAttribute('disabled', 'disabled');
        if (instantButton) instantButton.setAttribute('disabled', 'disabled');
        if (addLabel) addLabel.textContent = 'Unavailable';
        return;
      }

      if (priceEl) priceEl.textContent = formatMoney(variant.price);

      var onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
      if (compareEl) {
        compareEl.textContent = onSale ? formatMoney(variant.compare_at_price) : '';
        compareEl.hidden = !onSale;
      }
      if (badgeEl) {
        if (onSale) {
          var pct = Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100);
          badgeEl.textContent = 'Save ' + pct + '%';
          badgeEl.hidden = false;
        } else {
          badgeEl.hidden = true;
        }
      }

      if (stockDot) stockDot.classList.toggle('pdp-stock__dot--off', !variant.available);
      var lowStockEl = buyBox.querySelector('[data-pdp-low-stock]');
      if (lowStockEl) {
        var qtyLeft = inventory[variant.id];
        var isLow = variant.available && typeof qtyLeft === 'number' && qtyLeft > 0 && qtyLeft <= lowStockThreshold;
        lowStockEl.textContent = isLow ? 'Only ' + qtyLeft + ' left' : '';
        lowStockEl.hidden = !isLow;
      }
      if (stockText) {
        stockText.textContent = variant.available
          ? 'In Stock'
          : 'Currently Unavailable — Join the Waitlist';
      }

      if (variantIdInput) {
        variantIdInput.value = variant.id;
        variantIdInput.toggleAttribute('disabled', !variant.available);
      }
      if (addButton) addButton.toggleAttribute('disabled', !variant.available);
      if (addLabel) addLabel.textContent = variant.available ? 'Add to Cart' : 'Sold Out';
      if (instantButton) {
        instantButton.toggleAttribute('disabled', !variant.available);
        instantButton.dataset.variantId = variant.id;
      }
    }

    if (optionsWrapper) {
      optionsWrapper.addEventListener('click', function (evt) {
        var pill = evt.target.closest('.pdp-pill');
        if (!pill) return;

        var group = pill.closest('.pdp-option');
        var index = parseInt(pill.dataset.optionIndex, 10);
        selected[index] = pill.dataset.value;

        group.querySelectorAll('.pdp-pill').forEach(function (el) {
          el.classList.toggle('is-active', el === pill);
        });

        var valueLabel = group.querySelector('[data-pdp-option-value]');
        if (valueLabel) valueLabel.textContent = pill.dataset.value;

        updateUI(findMatchingVariant());
      });
    }

    function getCartSectionIds() {
      var ids = ['cart-icon-bubble'];
      if (document.querySelector('cart-drawer')) ids.push('cart-drawer');
      if (document.querySelector('cart-notification')) ids.push('cart-notification');
      return ids;
    }

    function updateCartBubbleFallback(itemCount) {
      var bubble = document.querySelector('.cart-count-bubble span[aria-hidden="true"]');
      if (bubble && typeof itemCount === 'number') bubble.textContent = itemCount;
    }

    var form = root.querySelector('.pdp-form');
    if (form) {
      form.addEventListener('submit', function (evt) {
        evt.preventDefault();
        var addButton = buyBox.querySelector('[data-pdp-add-to-cart]');
        var addLabel = buyBox.querySelector('[data-pdp-add-label]');
        var spinner = buyBox.querySelector('[data-pdp-spinner]');
        var errorBox = buyBox.querySelector('[data-pdp-error]');

        if (addButton.hasAttribute('disabled')) return;

        addButton.setAttribute('aria-disabled', 'true');
        if (spinner) spinner.hidden = false;
        if (errorBox) {
          errorBox.hidden = true;
          errorBox.textContent = '';
        }

        var formData = new FormData(form);
        formData.append('sections', JSON.stringify(getCartSectionIds()));
        formData.append('sections_url', window.location.pathname);

        fetch((window.routes && window.routes.cart_add_url) || '/cart/add', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        })
          .then(function (response) {
            return response.json();
          })
          .then(function (data) {
            if (data.status) {
              if (errorBox) {
                errorBox.hidden = false;
                errorBox.textContent = data.description || data.message || 'This item could not be added to your cart.';
              }
              return;
            }

            var cartDrawer = document.querySelector('cart-drawer');
            var cartNotification = document.querySelector('cart-notification');
            var cartUpdater = cartDrawer || cartNotification;

            if (cartUpdater && typeof cartUpdater.renderContents === 'function') {
              cartUpdater.renderContents(data);
            } else {
              updateCartBubbleFallback(data.item_count);
            }

            if (addLabel) {
              var previousLabel = addLabel.textContent;
              addLabel.textContent = 'Added ✓';
              setTimeout(function () {
                addLabel.textContent = previousLabel;
              }, 1800);
            }
          })
          .catch(function () {
            if (errorBox) {
              errorBox.hidden = false;
              errorBox.textContent = 'Something went wrong. Please try again.';
            }
          })
          .finally(function () {
            addButton.removeAttribute('aria-disabled');
            if (spinner) spinner.hidden = true;
          });
      });
    }

    var qtyInput = root.querySelector('[data-pdp-qty-input]');
    var qtyMinus = root.querySelector('[data-pdp-qty-minus]');
    var qtyPlus = root.querySelector('[data-pdp-qty-plus]');

    function getQuantity() {
      var qty = qtyInput ? parseInt(qtyInput.value, 10) : 1;
      return isNaN(qty) || qty < 1 ? 1 : qty;
    }

    function setQuantity(qty) {
      if (!qtyInput) return;
      qty = Math.max(1, qty);
      qtyInput.value = qty;
      if (qtyMinus) qtyMinus.toggleAttribute('disabled', qty <= 1);
    }

    if (qtyInput && qtyMinus && qtyPlus) {
      setQuantity(getQuantity());
      qtyMinus.addEventListener('click', function () {
        setQuantity(getQuantity() - 1);
      });
      qtyPlus.addEventListener('click', function () {
        setQuantity(getQuantity() + 1);
      });
      qtyInput.addEventListener('change', function () {
        setQuantity(getQuantity());
      });
    }

    var copyButton = root.querySelector('[data-pdp-copy-link]');
    var copiedStatus = root.querySelector('[data-pdp-copied]');
    if (copyButton) {
      copyButton.addEventListener('click', function () {
        var url = copyButton.dataset.url;
        var showCopied = function () {
          if (!copiedStatus) return;
          copiedStatus.textContent = 'Link copied';
          setTimeout(function () {
            copiedStatus.textContent = '';
          }, 2000);
        };
        if (navigator.share && window.matchMedia('(hover: none)').matches) {
          navigator.share({ title: document.title, url: url }).catch(function () {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(showCopied).catch(function () {
            window.prompt('Copy this link:', url);
          });
        } else {
          window.prompt('Copy this link:', url);
        }
      });
    }

    var instagramButton = root.querySelector('[data-pdp-instagram]');
    if (instagramButton) {
      instagramButton.addEventListener('click', function () {
        var url = instagramButton.dataset.url;
        // Instagram has no web share link: use the device share sheet when available,
        // otherwise copy the link and open Instagram so it can be pasted.
        if (navigator.share && window.matchMedia('(hover: none)').matches) {
          navigator.share({ title: document.title, url: url }).catch(function () {});
          return;
        }
        var openInstagram = function () {
          if (copiedStatus) {
            copiedStatus.textContent = 'Link copied, paste it in Instagram';
            setTimeout(function () {
              copiedStatus.textContent = '';
            }, 3000);
          }
          window.open('https://www.instagram.com/direct/inbox/', '_blank', 'noopener');
        };
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(openInstagram).catch(function () {
            window.prompt('Copy this link, then paste it in Instagram:', url);
          });
        } else {
          window.prompt('Copy this link, then paste it in Instagram:', url);
        }
      });
    }

    window.triggerDirectCheckout = function (variantId) {
      var id = variantId || (buyBox.querySelector('[data-pdp-instant-buy]') || {}).dataset.variantId;
      if (!id) return;
      window.location.href = '/cart/' + id + ':' + getQuantity() + '?checkout';
    };

    var instantBuyButton = root.querySelector('[data-pdp-instant-buy]');
    if (instantBuyButton) {
      instantBuyButton.addEventListener('click', function () {
        if (instantBuyButton.hasAttribute('disabled')) return;
        window.triggerDirectCheckout(instantBuyButton.dataset.variantId);
      });
    }
  })();
</script>

